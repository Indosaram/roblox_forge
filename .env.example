# Roblox Game Forge local environment template.
#
# Copy to .env.local (Git-ignored) and fill in your own values. Never commit real
# ids, group/user ids or API keys: the framework reads them from the environment
# and ships no defaults. `cli/forge/publish-staging.sh` sources .env.local
# automatically; every other command reads the same names from the process
# environment.

# Deploy targets referenced by games/<pack>/deploy.yml.
FORGE_STAGING_UNIVERSE_ID=
FORGE_STAGING_PLACE_ID=
FORGE_PRODUCTION_UNIVERSE_ID=
FORGE_PRODUCTION_PLACE_ID=

# Open Cloud credentials, one key per environment, plus the exact decimal target
# bindings deploy refuses to run without (they must match the target above).
ROBLOX_STAGING_API_KEY=
ROBLOX_STAGING_UNIVERSE_ID=
ROBLOX_STAGING_PLACE_ID=
ROBLOX_PRODUCTION_API_KEY=
ROBLOX_PRODUCTION_UNIVERSE_ID=
ROBLOX_PRODUCTION_PLACE_ID=

# Open Cloud key for asset, localization and cloud-smoke calls.
ROBLOX_API_KEY=

# Creator that owns uploaded audio: set exactly one (group id or user id).
FORGE_ROBLOX_CREATOR_GROUP_ID=
FORGE_ROBLOX_CREATOR_USER_ID=

# Real owner user id written into a published survival pack's provisioning.
FORGE_OWNER_USER_ID=

# Staging owner and QA actor allowlist recorded in a generated crafting pack.
FORGE_STAGING_OWNER_USER_ID=
FORGE_QA_ACTOR_IDS=

# Production human gate: set to 1 only with human approval and authorization.
FORGE_ALLOW_PRODUCTION=

# Release-candidate evaluator identity, attestation and invocation.
FORGE_QUALITY_EVALUATOR=
FORGE_QUALITY_ATTESTATION=
FORGE_QUALITY_EVALUATOR_EXECUTABLE=
FORGE_QUALITY_EVALUATOR_ARGS=

# Licensed generation providers.
IMAGE_GEN_URL=
TRELLIS_URL=
ELEVENLABS_API_KEY=

# Local host binding (the token is runtime-only).
FORGE_LOCAL_DB=
FORGE_LOCAL_TOKEN=
FORGE_LOCAL_NAMESPACE=
FORGE_LOCAL_PORT=
