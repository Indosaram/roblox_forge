--!strict
-- scaffold: pure text templates for `forge new`. Kept apart from the command so the
-- exact bytes a new pack starts from are testable under Lune (no filesystem).
--
-- `gameYml` and `projectJson` are genre-agnostic; `collectRaidFiles` adds the
-- playable collect-raid starter (world data, server loop, ui-kit HUD, procgen
-- asset specs) so a fresh pack runs in Studio with no hand-written code.

local Assets = require("./assets")

local M = {}

local ART_STYLE = '"stylized low-poly, chunky silhouettes, bright saturated palette, soft ambient light"'
local POLY_BUDGET = "{ creature: 2000, prop: 800, world_parts_max: 5000 }"

local function wordsOf(slug: string): { string }
	local words: { string } = {}
	for word in string.gmatch(slug, "[^-]+") do
		table.insert(words, word)
	end
	return words
end

--- True for a lowercase-kebab slug (a-z, 0-9, single hyphens, no leading/trailing).
function M.isValidSlug(slug: string): boolean
	if slug == "" then
		return false
	end
	if string.find(slug, "[^%l%d%-]") ~= nil then
		return false
	end
	if string.sub(slug, 1, 1) == "-" or string.sub(slug, -1) == "-" then
		return false
	end
	return string.find(slug, "--", 1, true) == nil
end

function M.titleCase(slug: string): string
	local words: { string } = {}
	for _, word in wordsOf(slug) do
		table.insert(words, string.upper(string.sub(word, 1, 1)) .. string.sub(word, 2))
	end
	return table.concat(words, " ")
end

function M.pascalCase(slug: string): string
	local words: { string } = {}
	for _, word in wordsOf(slug) do
		table.insert(words, string.upper(string.sub(word, 1, 1)) .. string.sub(word, 2))
	end
	return table.concat(words)
end

--- Replaces `__NAME__` placeholders. `string.gsub` gets a function replacement so
--- a value containing `%` is inserted literally.
function M.fill(text: string, vars: { [string]: string }): string
	local out = text
	for key, value in vars do
		out = string.gsub(out, key, function(): string
			return value
		end)
	end
	return out
end

--- game.yml for a fresh pack. art_style and poly_budget carry real defaults (never
--- `TBD`), so the new pack passes the check [game] stage immediately.
function M.gameYml(slug: string, genres: { string }): string
	return table.concat({
		"name: " .. M.titleCase(slug),
		"slug: " .. slug,
		"genres: [" .. table.concat(genres, ", ") .. "]",
		"currencies: [Coins]",
		"monetization: {gamepasses: [], products: [], subscriptions: []}",
		"art_style: " .. ART_STYLE,
		"poly_budget: " .. POLY_BUDGET,
		"locales: [en-us]",
		"qa_scenarios: [core-loop]",
		"liveops_cadence: weekly",
		"",
	}, "\n")
end

--- default.project.json mirroring the kaiju-egg-raiders pack: Forge.core (domain,
--- infra, anticheat, ui-kit), every requested genre module, the pack's shared
--- folder, Remotes, the server script, and the client script.
function M.projectJson(slug: string, pascal: string, genres: { string }): string
	local lines: { string } = {
		"{",
		'\t"name": "' .. slug .. '",',
		'\t"globIgnorePaths": ["**/*.spec.luau", "**/*.md", "**/.gitkeep", "**/*.yml"],',
		'\t"tree": {',
		'\t\t"$className": "DataModel",',
		'\t\t"ReplicatedStorage": {',
		'\t\t\t"Remotes": { "$className": "Folder" },',
		'\t\t\t"Forge": {',
		'\t\t\t\t"$className": "Folder",',
		'\t\t\t\t"core": {',
		'\t\t\t\t\t"$className": "Folder",',
		'\t\t\t\t\t"domain": { "$path": "../../core/domain" },',
		'\t\t\t\t\t"infra": { "$path": "../../core/infra" },',
		'\t\t\t\t\t"anticheat": { "$path": "../../core/anticheat" },',
		'\t\t\t\t\t"ui-kit": { "$path": "../../core/ui-kit" }',
		"\t\t\t\t},",
		'\t\t\t\t"genres": {',
		'\t\t\t\t\t"$className": "Folder",',
	}
	for index, genre in genres do
		table.insert(lines, '\t\t\t\t\t"' .. genre .. '": {')
		table.insert(lines, '\t\t\t\t\t\t"$className": "Folder",')
		table.insert(lines, '\t\t\t\t\t\t"module": { "$path": "../../genres/' .. genre .. '/module" }')
		local comma = if index < #genres then "," else ""
		table.insert(lines, "\t\t\t\t\t}" .. comma)
	end
	table.insert(lines, "\t\t\t\t},")
	table.insert(lines, '\t\t\t\t"games": {')
	table.insert(lines, '\t\t\t\t\t"$className": "Folder",')
	table.insert(lines, '\t\t\t\t\t"' .. slug .. '": {')
	table.insert(lines, '\t\t\t\t\t\t"$className": "Folder",')
	table.insert(lines, '\t\t\t\t\t\t"src": {')
	table.insert(lines, '\t\t\t\t\t\t\t"$className": "Folder",')
	table.insert(lines, '\t\t\t\t\t\t\t"shared": { "$path": "src/shared" }')
	table.insert(lines, "\t\t\t\t\t\t}")
	table.insert(lines, "\t\t\t\t\t}")
	table.insert(lines, "\t\t\t\t}")
	table.insert(lines, "\t\t\t}")
	table.insert(lines, "\t\t},")
	table.insert(lines, '\t\t"ServerScriptService": {')
	table.insert(lines, '\t\t\t"' .. pascal .. 'Server": { "$path": "src/server/' .. pascal .. 'Server.server.luau" }')
	table.insert(lines, "\t\t},")
	table.insert(lines, '\t\t"StarterPlayer": {')
	table.insert(lines, '\t\t\t"StarterPlayerScripts": {')
	table.insert(
		lines,
		'\t\t\t\t"' .. pascal .. 'Client": { "$path": "src/client/' .. pascal .. 'Client.client.luau" }'
	)
	table.insert(lines, "\t\t\t}")
	table.insert(lines, "\t\t}")
	table.insert(lines, "\t}")
	table.insert(lines, "}")
	table.insert(lines, "")
	return table.concat(lines, "\n")
end

--- Generic shared Config stub for packs whose genre ships no starter.
function M.configStub(slug: string): string
	return table.concat({
		"--!strict",
		"-- Config: pure data configuration for " .. M.titleCase(slug) .. ".",
		"",
		'local EconConfig = require("./EconConfig")',
		"",
		"local Config = {}",
		"",
		"Config.currency = EconConfig.currency",
		"Config.startingCoins = EconConfig.startingCoins",
		"Config.maxIncubators = EconConfig.maxIncubators",
		"",
		"return Config",
		"",
	}, "\n")
end

--- Generic server stub for packs whose genre ships no starter.
function M.serverStub(slug: string, pascal: string): string
	return table.concat({
		"--!strict",
		"-- " .. pascal .. "Server: bootstrap server stub for the " .. slug .. " pack.",
		"",
		'local ReplicatedStorage = game:GetService("ReplicatedStorage")',
		"local Forge = ReplicatedStorage.Forge",
		'local Config = require(Forge.games["' .. slug .. '"].src.shared.Config)',
		"",
		'print("' .. slug .. ' server starting with " .. Config.startingCoins .. " " .. Config.currency)',
		"",
	}, "\n")
end

--- Generic client stub for packs whose genre ships no starter.
function M.clientStub(slug: string, pascal: string): string
	return table.concat({
		"--!strict",
		"-- " .. pascal .. "Client: bootstrap client stub for the " .. slug .. " pack.",
		"",
		'print("' .. slug .. ' client ready")',
		"",
	}, "\n")
end

local PROC_GEN = [==[# Procedural asset specs for __TITLE__. `lune run cli/forge gen procedural --pack __SLUG__`
# reads this list and writes src/shared/ProcAssets.luau; edit and re-run to regenerate.
# kind is creature|prop; creature archetypes: quad|serpent|titan|biped.
assets:
  - key: emberling
    kind: creature
    archetype: quad
    scale: 1
    body: [220, 96, 48]
    accent: [255, 190, 80]
    eye: [40, 30, 30]
    seed: 1042
  - key: tidepup
    kind: creature
    archetype: biped
    scale: 0.9
    body: [70, 140, 220]
    accent: [180, 230, 255]
    eye: [20, 30, 50]
    seed: 2718
  - key: starter-egg
    kind: prop
    archetype: egg
    scale: 1
    body: [240, 230, 210]
    accent: [200, 90, 60]
    eye: [60, 60, 60]
    seed: 7
  - key: decor-rock
    kind: prop
    archetype: rock
    scale: 1
    body: [120, 120, 115]
    accent: [140, 140, 135]
    eye: [0, 0, 0]
    seed: 4400
]==]

-- Procedural audio cues for a fresh pack: one explore loop plus the two SFX the
-- scaffolded server loop actually triggers (hatch, coin). `lune run cli/forge
-- gen audio --pack __SLUG__` synthesises them with the pure core DSP/composer
-- (no API keys, no network); seeds are stable so every WAV is byte-identical.
local AUDIO_YML = [==[# Procedural audio cues for __TITLE__. `lune run cli/forge gen audio --pack __SLUG__`
# synthesises every cue under Lune with the pure core/domain/procgen DSP and
# composer (no API keys, no network), writes games/__SLUG__/assets/audio/<cue>.wav
# and upserts one forge-procgen/Approved manifest entry per cue.
#
# kind: music (mood explore|siege), sfx (type click|coin|hatch|rare|raid|error),
#       ambience (type wind|birds). duration is seconds; sampleRate optional.
cues:
  - key: musicExplore
    kind: music
    mood: explore
    duration: 75
    sampleRate: 22050
    seed: 1001
  - key: sfxHatch
    kind: sfx
    type: hatch
    duration: 0.5
    sampleRate: 44100
    seed: 3103
  - key: sfxCoin
    kind: sfx
    type: coin
    duration: 0.45
    sampleRate: 44100
    seed: 3102
]==]

local PROC_ASSETS = [==[--!strict
-- ProcAssets: written by `lune run cli/forge gen procedural --pack __SLUG__` from
-- assets/procgen.yml. Until it runs, this empty table keeps the pack playable:
-- the server falls back to simple colored parts for any key without a spec.
return {}
]==]

local CONFIG = [==[--!strict
-- Config: pure data for __TITLE__ (collect-raid).

export type ConfigData = {
	currency: string,
	startingCoins: number,
	teams: { string },
	teamColors: { [string]: BrickColor },
	maxIncubators: number,
	hatchSeconds: number,
	paradeSlots: number,
	creatureKeys: { string },
	coinsPerSecond: { [string]: number },
}

local Config: ConfigData = {
	currency = "Coins",
	startingCoins = 100,
	teams = { "Red", "Blue" },
	teamColors = {
		Red = BrickColor.new("Really red"),
		Blue = BrickColor.new("Bright blue"),
	},
	maxIncubators = 2,
	hatchSeconds = 2,
	paradeSlots = 3,
	-- Keys must match assets/procgen.yml.
	creatureKeys = { "emberling", "tidepup" },
	coinsPerSecond = { emberling = 1, tidepup = 2 },
}

return Config
]==]

local WORLD_LAYOUT = [==[--!strict
-- WorldLayout: pure world data for __TITLE__ (no Roblox APIs). WorldBuilder turns
-- it into the arena, two team bases with incubators, and parade slots.

export type Vec = { x: number, y: number, z: number }

export type ParadeLayout = {
	name: string,
	positions: { Vec },
}

export type BaseLayout = {
	team: string,
	center: Vec,
	size: Vec,
	spawn: Vec,
	spawnTeamColor: string,
	incubators: { Vec },
	vault: Vec,
	parade: ParadeLayout,
	shop: Vec,
	color: { r: number, g: number, b: number },
}

export type ArenaLayout = {
	center: Vec,
	radius: number,
	covers: { { position: Vec, size: Vec } },
	torches: { Vec },
}

export type Layout = {
	name: string,
	ground: { cells: number, cellSize: number, originX: number, originZ: number, y: number, thickness: number },
	bases: { BaseLayout },
	arena: ArenaLayout,
}

local INCUBATORS = 2
local PARADE_SLOTS = 3
local BASE_X = 70

local function vec(x: number, y: number, z: number): Vec
	return { x = x, y = y, z = z }
end

local function base(team: string, sign: number): BaseLayout
	local cx = sign * BASE_X
	local incubators: { Vec } = {}
	for i = 1, INCUBATORS do
		table.insert(incubators, vec(cx + sign * 14, 1, -12 + (i - 1) * 24))
	end
	local positions: { Vec } = {}
	for k = 1, PARADE_SLOTS do
		table.insert(positions, vec(cx - sign * 16, 1, -16 + (k - 1) * 16))
	end
	return {
		team = team,
		center = vec(cx, 0, 0),
		size = vec(56, 8, 56),
		spawn = vec(cx + sign * 20, 3, 0),
		spawnTeamColor = if sign < 0 then "Really red" else "Bright blue",
		incubators = incubators,
		vault = vec(cx - sign * 22, 2, 0),
		parade = { name = "Slot", positions = positions },
		shop = vec(cx + sign * 16, 1, 20),
		color = if sign < 0 then { r = 200, g = 50, b = 50 } else { r = 50, g = 90, b = 210 },
	}
end

local WorldLayout = {}

WorldLayout.layout = {
	name = "__PASCAL__World",
	ground = { cells = 12, cellSize = 25, originX = -150, originZ = -150, y = -0.5, thickness = 1 },
	bases = { base("Red", -1), base("Blue", 1) },
	arena = {
		center = vec(0, 0, 0),
		radius = 34,
		covers = {
			{ position = vec(16, 3, 16), size = vec(8, 6, 2) },
			{ position = vec(-16, 3, -16), size = vec(8, 6, 2) },
		},
		torches = { vec(26, 0, 0), vec(-26, 0, 0), vec(0, 0, 26), vec(0, 0, -26) },
	},
	decorations = {
		{ kind = "Rock", position = vec(44, 2, 44), scale = vec(5, 4, 5), seed = 1.5 },
		{ kind = "Rock", position = vec(-44, 2, -44), scale = vec(4, 3, 6), seed = 3.1 },
	},
	flowers = {},
}

return WorldLayout
]==]

