--!strict
local serde = require("@lune/serde")
return {
	template = serde.decode(
		"yaml",
		'# collect-raid economy template.\n#\n# Two consumers share this file:\n#   * `forge new <slug> --genre collect-raid` copies the top-level economy sections\n#     verbatim into a fresh pack (they are intentionally empty, so a new pack starts\n#     with the scaffolded starter economy).\n#   * `forge plan --genre collect-raid` reads the parametric `plan:` block below and\n#     expands it into a concrete games/<pack>/{game.yml,econ.yml,design/}. All\n#     collect-raid design knowledge - session shape, siege structure, tutorial,\n#     analytics events, ratings, tuning knobs, name pools, price ladder and balance\n#     targets - lives here so the planner stays genre-agnostic.\n\nplan:\n  currency: Coins\n  starting_coins: 100\n  incubators: 3\n  growth_per_owned: 0.2\n  active_slots: 6\n\n  session_target_minutes: 30\n  core_loop: "Buy an egg, hatch it in seconds, and let the creature earn Coins at the base; spend those Coins on bigger eggs, merge 3-of-a-kind up a rarity, and join the team siege every 10 minutes to raid the rival vault."\n  pillars:\n    - "Hatch in under 60 seconds: the first egg pays for itself inside the first minute."\n    - "Merge upward: three of a kind fuse into the next rarity, so the roster keeps growing."\n    - "Team siege, never personal theft: raids only touch the shared enemy vault."\n    - "Everything paid is deterministic: Robux buys fixed items, random hatching is free-currency only."\n\n  siege:\n    structure: "Two teams each defend a shared vault. Every siege period a window opens for a fixed duration and squads move up to max_take eggs from the enemy vault. Personal bases are never a raid target."\n    period_seconds: 600\n    duration_seconds: 120\n    max_take: 3\n\n  tutorial_steps:\n    - "Buy your first egg from the base shop"\n    - "Hold the incubator prompt to hatch it"\n    - "Watch the creature produce Coins on the parade slot"\n    - "Buy a bigger egg with the Coins you earned"\n    - "Merge three of a kind into the next rarity"\n    - "Open the store and read the deterministic item labels"\n\n  analytics_events:\n    - session_start\n    - session_end\n    - tutorial_step\n    - tutorial_complete\n    - egg_purchase\n    - egg_hatch\n    - kaiju_merge\n    - siege_join\n    - raid_success\n    - quest_claim\n    - store_open\n    - robux_purchase\n\n  ratings:\n    violence: "Mild fantasy only - creatures shove and bump in team sieges; no blood, no gore, no realistic weapons."\n    romance: "None."\n    gambling: "None. Random hatching uses free currency only and shows the pool odds; every Robux item is deterministic."\n    social: "Default Roblox chat only - no custom chat, no user-generated text, no voice, no external links."\n    language: "None (English UI strings only)."\n    paid_random: false\n\n  art_style: "chunky low-poly toy creatures, saturated team colors (red/blue), neon rarity accents, soft daylight with bloom"\n  poly_budget: { kaiju: 3000, egg: 600, prop: 800, world_parts_max: 6000 }\n\n  egg_count: { min: 2, max: 3 }\n  egg_base_price: 50\n  egg_price_multipliers: [1, 5, 15]\n  egg_hatch_seconds: [5, 15, 30]\n  egg_weight_profiles:\n    - [70, 25, 5]\n    - [60, 30, 10]\n    - [50, 35, 15]\n\n  rarity_tiers:\n    - { name: Common, coins_per_second: 1 }\n    - { name: Rare, coins_per_second: 3 }\n    - { name: Legendary, coins_per_second: 8 }\n\n  creature_suffixes:\n    Common: [Pup, Hatchling, Scamper]\n    Rare: [Mauler, Serpent, Stalker]\n    Legendary: [Titan, Leviathan, Colossus]\n\n  fallback_nouns: [Kaiju, Vault, Island, Sky, Ember, Tidal]\n  # Base hue families an egg\'s own body color is snapped to (HSV hue degrees).\n  # Every egg picks the nearest family so its roster reads as a distinct\n  # palette from every other egg, instead of every egg sharing one look.\n  egg_hue_families: [18, 210, 140, 280, 45, 320]\n  # Rarity raises saturation/brightness/accent intensity on top of the egg\'s\n  # hue family; body/accent/eye all derive from (egg hue x tier style).\n  tier_style:\n    Common: { saturation: 0.55, brightness: 0.62, accent_boost: 0.12 }\n    Rare: { saturation: 0.72, brightness: 0.7, accent_boost: 0.22 }\n    Legendary: { saturation: 0.88, brightness: 0.8, accent_boost: 0.35 }\n  # Fallback archetype per tier, used only when the creature\'s name noun (its\n  # suffix) doesn\'t match any keyword below.\n  archetypes:\n    Common: quad\n    Rare: quad\n    Legendary: titan\n  # Name noun -> archetype. Checked against the lower-cased creature suffix\n  # before falling back to `archetypes` above, so "Serpent"/"Leviathan" render\n  # as the serpent archetype even in the Legendary tier, etc.\n  archetype_keywords:\n    serpent: serpent\n    snake: serpent\n    eel: serpent\n    leviathan: serpent\n    wyrm: serpent\n    titan: titan\n    colossus: titan\n    golem: titan\n    pup: quad\n    hatchling: quad\n    scamper: quad\n    runner: quad\n    stalker: quad\n    mauler: biped\n    brute: biped\n  scales:\n    Common: 1\n    Rare: 1.4\n    Legendary: 2\n\n  merges:\n    - { from: Common, count: 3, to: Rare }\n    - { from: Rare, count: 3, to: Legendary }\n\n  daily_quests:\n    - { id: hatch, text: "Hatch 3 eggs", reward: 100 }\n    - { id: buy, text: "Buy 5 eggs", reward: 150 }\n    - { id: raid, text: "Join 1 siege", reward: 300 }\n\n  monetization:\n    price_ladder:\n      low: 99\n      mid: 199\n      high: 499\n      premium: 699\n    gamepasses:\n      - { key: coins2x, name: "2x Coins", tier: premium, effect: "Doubles coin income." }\n      - { key: vipSlots, name: "VIP Slots +4", tier: premium, effect: "Adds four incubator slots." }\n      - { key: autoLock, name: "Auto Lock", tier: mid, effect: "Auto-locks your creatures before a siege." }\n    products:\n      - { key: creaturePack, name: "Guaranteed Rare Creature Pack", tier: low, effect: "Grants one fixed Rare creature." }\n      - { key: hatchSpeedup, name: "Hatch Speed-Up", tier: premium, effect: "Instantly finishes the current hatch." }\n      - { key: siegeShield, name: "Siege Shield", tier: low, effect: "Protects your team vault from raids for 10 minutes while you remain in the server." }\n      - { key: luckBoost, name: "Server Luck Boost 15m", tier: mid, effect: "Improves free-hatch odds for the server for 15 minutes." }\n\n  fairness_rules:\n    - "Every Robux item is deterministic: the label names exactly what is granted."\n    - "Random hatching runs only on free currency; no Robux ever opens a random roll."\n    - "The luck boost only shifts free-hatch odds and never sells a random item."\n    - "A team siege only moves free-produced Common value; paid creatures are never stolen."\n\n  store_tags: [Collect, Simulation, Team, Strategy, Idle, Fantasy]\n\n  first_purchase_target_minutes: [10, 30]\n  day7_growth_max_percent: 25\n  egg_sink_min_percent: 5\n\n# The scaffold/economy sections consumed by `forge new` and codegen. Left empty so a\n# fresh `forge new` pack starts from the playable starter economy. `forge plan`\n# synthesizes the full economy from the `plan:` block above.\ncurrencies: []\nsources: []\nsinks: []\n'
	).plan,
	design = '# __TITLE__ - design\n\nConcept: __CONCEPT__\n\n__TITLE__ is a collect-raid pack. __CORE_LOOP__ Sessions target __SESSION_TARGET__\nminutes; every __SIEGE_PERIOD__ seconds a __SIEGE_DURATION__ second team siege window\nopens on the shared vault.\n\n## Pillars\n\n__PILLARS__\n\n## Core loop\n\n__CORE_LOOP__\n\n## Social and siege\n\n__SIEGE_STRUCTURE__ The design deliberately avoids 1:1 personal-base theft\nand the "Steal a ..." title pattern, and routes all conflict through the team vault\nsiege instead.\n\n## Retention\n\n__RETENTION__\n\n## Roster\n\nEggs: __EGG_LIST__.\n\nCreatures: __CREATURE_LIST__.\n\n## Balance\n\nTuned by `forge plan` against the economy simulator; see `balance.md` for the\nsection-7 targets and `monetization.md` for the store strategy.\n',
}
