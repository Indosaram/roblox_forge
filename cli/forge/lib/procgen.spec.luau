--!strict
-- Specs for procgen: pure procgen.yml + poly_budget -> resolved specs planning,
-- budget selection, the over-budget refusal, and byte-stable rendering.

local procgen = require("./procgen")

local function doc(assets: { any }): any
	return { assets = assets }
end

local CREATURE: any = {
	key = "pyro-pup",
	kind = "creature",
	archetype = "quad",
	scale = 1,
	body = { 235, 110, 40 },
	accent = { 255, 200, 60 },
	eye = { 255, 255, 180 },
	seed = 1001,
}

local EGG: any = {
	key = "ember-egg",
	kind = "prop",
	archetype = "egg",
	scale = 1,
	body = { 240, 120, 40 },
	accent = { 255, 210, 90 },
	seed = 2001,
}

local BUDGETS: any = { kaiju = 3000, egg = 600, prop = 800 }

local TREE: any = {
	key = "decor-tree",
	kind = "prop",
	archetype = "tree",
	scale = 1,
	body = { 120, 82, 44 },
	accent = { 214, 86, 72 },
	foliage = { 90, 170, 70 },
	seed = 3001,
}

return {
	["a valid document resolves to a creature spec"] = function()
		local resolved, errors = procgen.plan(doc({ CREATURE }), BUDGETS)
		assert(#errors == 0, "expected no errors, got " .. table.concat(errors, "; "))
		assert(resolved ~= nil and #resolved == 1, "expected one resolved asset")
		local entry = (resolved :: { procgen.Resolved })[1]
		assert(entry.kind == "creature", "kind must be creature")
		assert(entry.archetype == "quad", "archetype must be quad")
		assert(entry.seed == 1001, "seed must round-trip")
		assert(entry.spec.archetype == "quad", "creature spec carries the archetype")
		assert(entry.spec.polyBudget == 3000, "spec must use the resolved budget")
		assert(entry.triangleCount <= entry.budget, "resolved tris must fit the budget")
	end,

	["a valid egg resolves through Prop.generate"] = function()
		local resolved, errors = procgen.plan(doc({ EGG }), BUDGETS)
		assert(#errors == 0, "expected no errors, got " .. table.concat(errors, "; "))
		local entry = (resolved :: { procgen.Resolved })[1]
		assert(entry.kind == "prop" and entry.archetype == "egg", "expected an egg prop")
		assert(entry.spec.eye == nil, "egg specs must not carry an eye color")
		assert(entry.budget == 600, "egg budget comes from poly_budget.egg")
		assert(entry.triangleCount <= 600, "egg tris must fit the budget")
	end,

	["creature budget prefers kaiju over creature"] = function()
		assert(procgen.budgetFor("creature", "quad", { kaiju = 1200, creature = 999 }) == 1200, "kaiju wins")
		assert(procgen.budgetFor("creature", "quad", { creature = 999 }) == 999, "creature is the fallback")
		assert(procgen.budgetFor("creature", "quad", {}) == 3000, "final creature fallback is 3000")
	end,

	["prop budget is egg for eggs and prop otherwise"] = function()
		assert(procgen.budgetFor("prop", "egg", { egg = 512, prop = 800 }) == 512, "egg key wins for eggs")
		assert(procgen.budgetFor("prop", "rock", { egg = 512, prop = 800 }) == 800, "prop key wins for rocks")
		assert(procgen.budgetFor("prop", "egg", {}) == 600, "final egg fallback is 600")
		assert(procgen.budgetFor("prop", "crystal", {}) == 800, "final prop fallback is 800")
	end,

	["an asset that cannot fit its budget is refused"] = function()
		local resolved, errors = procgen.plan(doc({ CREATURE }), { kaiju = 1 })
		assert(resolved ~= nil, "planning still resolves the entries")
		assert(#errors == 1, "a tiny budget must produce exactly one error")
		assert(string.find(errors[1], "exceeds budget", 1, true) ~= nil, "error must say it exceeds budget")
		assert(string.find(errors[1], "pyro-pup", 1, true) ~= nil, "error must name the asset")
	end,

	["parse rejects an invalid archetype, color, and seed"] = function()
		local bad = {
			key = "mystery",
			kind = "creature",
			archetype = "dragon",
			scale = 1,
			body = { 999, 0, 0 },
			accent = { 0, 0, 0 },
			eye = { 0, 0, 0 },
			seed = "nope",
		}
		local _, errors = procgen.plan(doc({ bad }), BUDGETS)
		assert(#errors >= 3, "invalid archetype, color, and seed must each be reported")
	end,

	["renderLuau is byte-stable and covers every key"] = function()
		local resolved, errors = procgen.plan(doc({ EGG, CREATURE }), BUDGETS)
		assert(#errors == 0, "expected no errors, got " .. table.concat(errors, "; "))
		local typed = resolved :: { procgen.Resolved }
		local first = procgen.renderLuau(typed)
		local second = procgen.renderLuau(typed)
		assert(first == second, "two renders must be identical")
		assert(
			string.find(first, "-- GENERATED by forge gen procedural; do not edit", 1, true) ~= nil,
			"render must keep the generated header"
		)
		assert(string.find(first, '["pyro-pup"]', 1, true) ~= nil, "render must contain the creature key")
		assert(string.find(first, '["ember-egg"]', 1, true) ~= nil, "render must contain the egg key")
	end,

	["prop foliage round-trips into the spec and the generated module"] = function()
		local resolved, errors = procgen.plan(doc({ TREE }), BUDGETS)
		assert(#errors == 0, "expected no errors, got " .. table.concat(errors, "; "))
		local entry = (resolved :: { procgen.Resolved })[1]
		assert(entry.spec.foliage ~= nil, "tree spec carries foliage")
		assert(entry.spec.foliage.g > entry.spec.foliage.r, "foliage is green")
		local luau = procgen.renderLuau(resolved :: { procgen.Resolved })
		assert(string.find(luau, "foliage =", 1, true) ~= nil, "generated module emits foliage")
	end,

	["an invalid foliage colour is reported"] = function()
		local bad = table.clone(TREE)
		bad.foliage = { 300, 0, 0 }
		local _, errors = procgen.plan(doc({ bad }), BUDGETS)
		assert(#errors == 1, "invalid foliage must be reported")
		assert(string.find(errors[1], "foliage", 1, true) ~= nil, "error must mention foliage")
	end,

	["buildMesh regenerates and renderObj serialises the OBJ preview"] = function()
		local resolved, errors = procgen.plan(doc({ EGG, CREATURE }), BUDGETS)
		assert(#errors == 0, "expected no errors, got " .. table.concat(errors, "; "))
		local typed = resolved :: { procgen.Resolved }
		for _, entry in typed do
			local mesh = procgen.buildMesh(entry)
			local obj = procgen.renderObj(mesh)
			assert(obj == procgen.renderObj(mesh), "OBJ render is reproducible")
			assert(string.find(obj, "\nv ", 1, true) ~= nil, "OBJ has vertex lines")
			assert(string.find(obj, "\nvn ", 1, true) ~= nil, "OBJ has normal lines")
			local faces = 0
			for _ in string.gmatch(obj, "\nf ") do
				faces += 1
			end
			assert(faces == mesh.triangleCount, "one OBJ face per triangle")
		end
	end,
}
