--!strict
-- SmokePlan: builds the Roblox Open Cloud Luau Execution request used by
-- `forge smoke --cloud`. Pure and network-free: validation, JSON encoding, and
-- bundling a smoke script into one self-contained source string.

local serde = require("@lune/serde")

local M = {}

-- Luau Execution tasks may run for up to 5 minutes; keep a single task per call.
M.DEFAULT_TIMEOUT = "300s"

local REQUIRE_CALL = "%f[%a_]require%s*%(%s*[\"']([^\"']+)[\"']%s*%)"

local BUNDLE_HEADER = table.concat({
	"--!nocheck",
	"-- Self-contained smoke bundle generated by `forge smoke` (Open Cloud Luau Execution).",
	"local __modules: { [string]: () -> any } = {}",
	"local __cache: { [string]: any } = {}",
	"",
	"local function __require(path: string): any",
	"\tlocal cached = __cache[path]",
	"\tif cached ~= nil then",
	"\t\treturn cached",
	"\tend",
	"\tlocal loader = __modules[path]",
	"\tif loader == nil then",
	'\t\terror("bundled module not found: " .. tostring(path))',
	"\tend",
	"\tlocal module = loader()",
	"\t__cache[path] = module",
	"\treturn module",
	"end",
	"",
}, "\n")

-- Collapses `.`/`..` segments so every module has one canonical key.
local function normalizePath(path: string): string
	local parts: { string } = {}
	for segment in string.gmatch(path, "[^/]+") do
		if segment == "." then
			continue
		elseif segment == ".." then
			table.remove(parts)
		else
			table.insert(parts, segment)
		end
	end
	return table.concat(parts, "/")
end

local function dirname(path: string): string
	return string.match(path, "^(.*)/[^/]*$") or ""
end

local function isRelative(spec: string): boolean
	return string.sub(spec, 1, 1) == "."
end

-- Inlines the transitive closure of `entryPath` into one script. Each module
-- becomes a loader keyed by its resolved path, relative `require(...)` calls are
-- rewritten to `__require(<path>)`, and the entry's `run()` reports PASS lines.
-- `readSource(path)` returns the file text (with `.luau`) or nil when missing.
function M.bundle(entryPath: string, readSource: (string) -> string?): (string?, string?)
	local entry = (string.gsub(entryPath, "%.luau$", "")) :: string

	local bodies: { [string]: string } = {}
	local order: { string } = {}
	local queue: { string } = { entry }

	local function load(path: string): boolean
		if bodies[path] ~= nil then
			return true
		end
		local filename = path .. ".luau"
		local source = readSource(filename)
		if source == nil then
			filename = path .. "/init.luau"
			source = readSource(filename)
		end
		if source == nil then
			return false
		end
		local base = dirname(filename)
		local rewritten = string.gsub(source, REQUIRE_CALL, function(spec: string): string
			if not isRelative(spec) then
				return "require(" .. string.format("%q", spec) .. ")"
			end
			local resolved = normalizePath(base .. "/" .. spec)
			table.insert(queue, resolved)
			return "__require(" .. string.format("%q", resolved) .. ")"
		end)
		bodies[path] = rewritten
		table.insert(order, path)
		return true
	end

	local index = 1
	while index <= #queue do
		local path = queue[index]
		index += 1
		if not load(path) then
			return nil, "cannot resolve bundled module: " .. path
		end
	end

	local parts: { string } = { BUNDLE_HEADER }
	for _, path in order do
		table.insert(parts, "__modules[" .. string.format("%q", path) .. "] = function()\n")
		table.insert(parts, bodies[path])
		table.insert(parts, "\nend\n\n")
	end
	table.insert(
		parts,
		table.concat({
			"local __smoke = __require(" .. string.format("%q", entry) .. ")",
			"local __checks = __smoke.run(nil)",
			"local __count = 0",
			"local __failed = 0",
			"for _, __check in __checks do",
			"\t__count += 1",
			"\tif __check.ok then",
			'\t\tprint("PASS " .. __check.name)',
			"\telse",
			"\t\t__failed += 1",
			'\t\tprint("FAIL " .. __check.name .. ": " .. tostring(__check.detail))',
			"\tend",
			"end",
			"if __failed == 0 then",
			'\tprint(string.format("smoke: PASS (%d checks)", __count))',
			"else",
			'\tprint("smoke: FAIL")',
			'\terror(string.format("%d smoke check(s) failed", __failed))',
			"end",
			"",
		}, "\n")
	)
	return table.concat(parts), nil
end

export type Request = {
	method: string,
	url: string,
	body: string,
}

local function isPositiveNumber(value: any): boolean
	return type(value) == "number" and value == value and value > 0 and value ~= math.huge
end

function M.buildUrl(universeId: number, placeId: number): string
	return string.format(
		"https://apis.roblox.com/cloud/v2/universes/%d/places/%d/luau-execution-session-tasks",
		universeId,
		placeId
	)
end

-- Encodes the task body with a stable key order (script, then timeout) so the
-- dry-run preview is deterministic. `script` is JSON-escaped by serde.
function M.buildBody(script: string, timeout: string?): string
	local encodedScript = serde.encode("json", script)
	return '{"script":' .. encodedScript .. ',"timeout":"' .. (timeout or M.DEFAULT_TIMEOUT) .. '"}'
end

--- Builds the POST request for a staging Luau Execution task. Returns
--- (nil, reason) when the staging ids are unset (0).
function M.buildRequest(universeId: any, placeId: any, script: string, timeout: string?): (Request?, string?)
	if not isPositiveNumber(placeId) then
		return nil, "staging placeId is 0 in deploy.yml"
	end
	if not isPositiveNumber(universeId) then
		return nil, "staging universeId is 0 in deploy.yml"
	end
	return {
		method = "POST",
		url = M.buildUrl(universeId, placeId),
		body = M.buildBody(script, timeout),
	}, nil
end

return M
