--!strict
local fs = require("@lune/fs")
local tempdir = require("./tempdir")
local luau = require("@lune/luau")
local process = require("@lune/process")
local serde = require("@lune/serde")
local Content = require("../../../core/domain/survival/Content")
local Capability = require("../../../core/domain/survival/Capability")
local render = require("./contentrender")
local command = require("../commands/content")
local generate = require("./genregenerate")

local function fixture(): any
	return {
		survival_content = 1,
		rules = table.clone(Content.RULES),
		limits = table.clone(Content.DEFAULT_LIMITS),
		items = { { id = "berry", name = "Berry", stackMax = 10, weightMilli = 100 } },
	}
end

return {
	["existing v1 pack renders byte identically to its generated artifact"] = function()
		for _, pack in { "kaiju-egg-raiders", "grow-and-defend-garden", "plan-demo", "robango-island" } do
			local dir = "games/" .. pack
			if fs.isFile(dir .. "/content.yml") then
				local raw = serde.decode("yaml", fs.readFile(dir .. "/content.yml"))
				if raw.survival_content == 1 then
					local rendered = assert(render.build(raw, "crafting"))
					assert(
						rendered.content == fs.readFile(dir .. "/src/shared/SurvivalContent.luau"),
						"v1 generated bytes unchanged: " .. pack
					)
				end
			end
		end
	end,
	["v2 output is compact: closed rows skip constructors and the payload decodes to the canonical document"] = function()
		local raw = serde.decode("yaml", fs.readFile("games/robango-island/content.yml"))
		local rendered = assert(render.build(raw, "crafting"))
		local source = rendered.content
		assert(string.find(source, "{x=0,y=2,z=-96}", 1, true) ~= nil, "closed point rows have no wrapper")
		assert(string.find(source, "V2_point): V2_point", 1, true) == nil, "no constructor for a closed row type")
		assert(
			string.find(source, '["id"]', 1, true) == nil and string.find(source, "{id=", 1, true) ~= nil,
			"identifier keys are emitted bare"
		)
		local decoded = luau.load(source)()
		local canonical = assert(Content.canonicalize(raw))
		local contract = require("./genrecontract")
		for key, value in canonical :: any do
			assert(contract.serialize(decoded[key]) == contract.serialize(value), "payload field " .. key)
		end
	end,
	["v2 renders detailed catalogs without changing legacy generated bytes"] = function()
		local raw = fixture()
		local legacy = assert(render.build(raw, "crafting")).content
		raw.survival_content = 2
		raw.materials = {
			{
				id = "berry-profile",
				provenance = { classification = "RECONSTRUCTED" },
				item = "berry",
				attributes = {
					hardness = 0,
					flexibility = 0,
					sharpness = 0,
					insulation = 0,
					nutrition = 5,
					fertility = 1,
				},
				levels = { 20, 1 },
				quality = 0,
				processingBudget = 3,
				sources = { "shore" },
			},
		}
		local rendered = assert(render.build(raw, "crafting"))
		local decoded = luau.load(rendered.content)()
		assert(decoded.version == 2 and decoded.materials[1].levels[1] == 1, "detailed levels ship sorted")
		assert(decoded.materials[1].attributes.nutrition == 5, "material attributes ship")
		assert(assert(render.build(fixture(), "crafting")).content == legacy, "legacy generated bytes unchanged")
	end,
	["v2 heterogeneous optional row fields type check in generated source"] = function()
		local root = generate.absolute(
			tempdir.root() .. "/forge-content-v2-types-" .. serde.hash("sha256", tostring(os.clock())):sub(1, 16)
		)
		local ok, reason = xpcall(function()
			generate.ensureDir(root)
			local raw = fixture()
			raw.survival_content = 2
			raw.structures = {
				{
					id = "bench",
					footprintX = 1,
					footprintZ = 1,
					station = true,
					cost = { { item = "berry", quantity = 1 } },
				},
			}
			raw.operations = {}
			local gatesByOperation: { { characterLevel: number?, capability: string?, clanLevel: number? } } = {
				{ characterLevel = 1 },
				{ capability = "craft", clanLevel = 1 },
				{},
			}
			for index, gates in gatesByOperation do
				table.insert(raw.operations, {
					id = "operation-" .. index,
					provenance = { classification = "RECONSTRUCTED" },
					kind = "practice",
					inputs = { { item = "berry", quantity = 1 } },
					outputs = {},
					seconds = 1,
					effects = {},
					gates = gates,
					station = if index == 1 then "bench" else nil,
					stationTier = if index == 1 then 1 else nil,
				})
			end
			local rendered, errors = render.build(raw, "crafting")
			assert(rendered, table.concat(errors, "; "))
			local path = root .. "/SurvivalContent.luau"
			fs.writeFile(path, rendered.content)
			local result = process.exec("luau-lsp", { "analyze", "--platform=standard", path })
			assert(result.ok, result.stdout .. result.stderr)
			local decoded = luau.load(rendered.content)()
			assert(
				decoded.operations[1].stationTier == 1 and decoded.operations[2].stationTier == nil,
				"station tier remains optional across rows"
			)
			assert(
				decoded.operations[2].gates.capability == "craft" and decoded.operations[3].gates.capability == nil,
				"nested gates preserve heterogeneous optional fields"
			)
		end, debug.traceback)
		if fs.isDir(root) then
			fs.removeDir(root)
		end
		assert(ok, tostring(reason))
	end,
	["econ mismatch rejects drift and sync rewrites only embedded block"] = function()
		local raw = fixture()
		local document = assert(Content.canonicalize(raw))
		local source =
			"# before\ncurrencies: []\ngenre_contract:\n  configs:\n    survival-coop:\n      inventory:\n        content:\n          stale: true\n        carriedContainer: bag\n# after\nproducts: []\n"
		local econ = serde.decode("yaml", source)
		assert(#command.econErrors(document, econ) > 0, "econ mismatch is rejected")
		local synced, reason = command.syncText(source, document)
		assert(synced, reason)
		local prefix = assert(source:match("^(.-content:\n)"))
		assert(synced:sub(1, #prefix) == prefix, "prefix outside content retained")
		assert(
			synced:sub(-#"        carriedContainer: bag\n# after\nproducts: []\n")
				== "        carriedContainer: bag\n# after\nproducts: []\n",
			"suffix retained"
		)
		assert(
			#command.econErrors(document, serde.decode("yaml", synced)) == 0,
			"synchronized canonical projection matches"
		)
		assert(command.syncText(synced, document) == synced, "sync is idempotent")
	end,
	["skills content renders a typed skills table and its absence changes nothing"] = function()
		local plain = assert(render.build(fixture(), "crafting"))
		assert(not string.find(plain.content, "SkillGrant", 1, true), "no skills section, no skills types")
		local raw = fixture()
		local disciplines = {}
		for _, id in { "f", "e", "d", "c", "b", "a" } do
			table.insert(disciplines, { id = id, thresholds = { 5, 20 } })
		end
		raw.skills = { baseStep = 1, disciplines = disciplines }
		raw.nodes = {
			{
				id = "bush",
				respawnMillis = 1000,
				harvest = { { item = "berry", quantity = 1 } },
				skill = { id = "b", xp = 3 },
			},
		}
		local rendered = assert(render.build(raw, "crafting"))
		local decoded = luau.load(rendered.content)()
		assert(#decoded.skills.disciplines == 6 and decoded.skills.disciplines[1].id == "a", "sorted skills ship")
		assert(decoded.skills.disciplines[1].thresholds[2] == 20, "thresholds ship")
		assert(decoded.nodes[1].skill.xp == 3, "node grant ships")
		assert(string.find(rendered.content, "skills: Skills?", 1, true), "generated type carries skills")
		local repeated = assert(render.build(raw, "crafting"))
		assert(repeated.content == rendered.content, "skills render byte-identical")
		raw.skills.disciplines[1].thresholds = { 20, 5 }
		local refused, errors = render.build(raw, "crafting")
		assert(refused == nil and #errors > 0, "invalid skills never render")
	end,
	["legacy content preserves absent optional values and current capability payload"] = function()
		local rendered = render.build(fixture(), "crafting")
		assert(rendered ~= nil, "legacy fixture renders")
		local decoded = luau.load(rendered.content)()
		assert(decoded.vitals == nil and decoded.items[1].foodEffects == nil, "optional values stay absent")
		local descriptor = Capability.describe("crafting")
		assert(decoded.capability.actionVersion == descriptor.actionVersion, "current action version ships")
		assert(decoded.capability.saveVersion == descriptor.saveVersion, "current save version ships")
		assert(#decoded.capability.actions == #descriptor.actions, "all current actions ship")
		for index, action in descriptor.actions do
			assert(decoded.capability.actions[index] == action, "canonical action ordering ships")
		end
		for index, feature in descriptor.features.implemented do
			assert(decoded.capability.features.implemented[index] == feature, "implemented capability ships")
		end
		assert(
			#decoded.capability.features.implemented == #descriptor.features.implemented,
			"no invented capability ships"
		)
		local repeated = assert(render.build(fixture(), "crafting"))
		assert(repeated.content == rendered.content, "same content and capability render identical bytes")
	end,
	["food and vitals codegen retains machine values and generated types"] = function()
		local root = generate.absolute(
			tempdir.root() .. "/forge-content-render-" .. serde.hash("sha256", tostring(os.clock())):sub(1, 16)
		)
		local packDir = root .. "/fixture"
		local ok, reason = xpcall(function()
			generate.ensureDir(packDir)
			local raw = fixture()
			raw.vitals = { fatigueMilliPerAction = 0 }
			raw.items[1].foodEffects = { hungerMilli = 12345, healthMilli = 2000, fatigueMilli = 3000 }
			fs.writeFile(packDir .. "/content.yml", serde.encode("yaml", raw))
			assert(command.codegen("fixture", { packsDir = root }), "real codegen succeeds")
			local path = packDir .. "/src/shared/SurvivalContent.luau"
			local first = fs.readFile(path)
			local decoded = luau.load(first)()
			assert(decoded.vitals.hungerMillisPerUnit == 18000, "resolved hunger default ships")
			assert(decoded.vitals.starvationMillisPerUnit == 5000, "resolved starvation default ships")
			assert(decoded.vitals.restMilliPerSecond == 2000, "resolved rest default ships")
			assert(decoded.vitals.fatigueMilliPerAction == 0, "zero override ships")
			local food = decoded.items[1].foodEffects
			assert(food.hungerMilli == 12345 and food.healthMilli == 2000 and food.fatigueMilli == 3000, "food ships")
			assert(command.codegen("fixture", { packsDir = root }), "repeat codegen succeeds")
			assert(fs.readFile(path) == first, "codegen bytes deterministic")
			fs.writeFile(
				packDir .. "/consumer.luau",
				[[--!strict
local Catalog = require("./src/shared/SurvivalContent")
local food: Catalog.FoodEffects? = Catalog.items[1].foodEffects
local vitals: Catalog.VitalsConfig? = Catalog.vitals
if food then
	local value: number = food.hungerMilli + food.healthMilli + food.fatigueMilli
	assert(value >= 0)
end
if vitals then
	local value: number = vitals.hungerMillisPerUnit + vitals.starvationMillisPerUnit + vitals.restMilliPerSecond + vitals.fatigueMilliPerAction
	assert(value >= 0)
end
]]
			)
			local result =
				process.exec("luau-lsp", { "analyze", "--platform=standard", path, packDir .. "/consumer.luau" })
			assert(result.ok, result.stdout .. result.stderr)
		end, debug.traceback)
		if fs.isDir(root) then
			fs.removeDir(root)
		end
		assert(ok, tostring(reason))
	end,
	["contracts section renders typed data and stays absent when undeclared"] = function()
		local plain = assert(render.build(fixture(), "crafting"))
		assert(luau.load(plain.content)().contracts == nil, "no contracts section without source data")
		assert(not string.find(plain.content, "ContractCatalog", 1, true), "no contract types without data")
		local raw = fixture()
		raw.contracts = {
			factions = { { id = "guild", name = "Guild", trustThresholds = { 0, 1, 2, 3, 4 } } },
			entries = {
				{
					id = "c",
					faction = "guild",
					pool = "first-day",
					deliver = { { item = "berry", quantity = 1 } },
					trust = 1,
				},
				{
					id = "b",
					faction = "guild",
					pool = "first-day",
					deliver = { { item = "berry", quantity = 1 } },
					trust = 1,
				},
				{
					id = "a",
					faction = "guild",
					pool = "first-day",
					deliver = { { item = "berry", quantity = 1 } },
					trust = 1,
				},
				{
					id = "d1",
					faction = "guild",
					pool = "daily",
					deliver = { { item = "berry", quantity = 1 } },
					trust = 1,
				},
				{
					id = "d2",
					faction = "guild",
					pool = "daily",
					deliver = { { item = "berry", quantity = 1 } },
					trust = 1,
				},
				{
					id = "d3",
					faction = "guild",
					pool = "daily",
					deliver = { { item = "berry", quantity = 1 } },
					trust = 1,
				},
			},
			firstDay = { "c", "b", "a" },
		}
		local rendered = assert(render.build(raw, "crafting"))
		assert(string.find(rendered.content, "contracts: ContractCatalog?", 1, true), "typed contracts field")
		local decoded = luau.load(rendered.content)().contracts
		assert(decoded.firstDay[1] == "c" and decoded.firstDay[3] == "a", "authored first-day order kept")
		assert(decoded.entries[1].id == "a", "entries canonical by id")
		assert(decoded.dailyCount == 3 and decoded.swapCooldownMillis == 3600000, "defaults resolved")
		assert(decoded.factions[1].trustThresholds[5] == 4, "thresholds ship")
		assert((assert(render.build(raw, "crafting"))).content == rendered.content, "deterministic bytes")
		raw.contracts.firstDay = { "c", "b" }
		assert(render.build(raw, "crafting") == nil, "malformed contracts refuse to render")
	end,
}
