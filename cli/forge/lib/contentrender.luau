--!strict
-- contentrender: deterministic rendering of a canonical survival content
-- catalog into the pack's generated Luau source.
--
-- Determinism is structural, not incidental: lib/contentschema returns a
-- canonical document (every catalog sorted by id, every quantity list sorted
-- by item id) and `genrecontract.serialize` emits table keys in sorted order.
-- Two runs over the same source therefore produce byte-identical output, which
-- is what `content codegen` proves by writing twice and comparing.
--
-- This renders DATA. It generates no behaviour, and it must never emit a
-- mechanism a capability descriptor has not declared as implemented.

local contract = require("./genrecontract")
local Content = require("../../../core/domain/survival/Content")
local ContentV2 = require("../../../core/domain/survival/ContentV2")
local Capability = require("../../../core/domain/survival/Capability")
local process = require("@lune/process")

local M = {}

M.OUTPUT_NAME = "SurvivalContent.luau"

local HEADER = "--!strict\n-- GENERATED by `lune run cli/forge content codegen`. Do not edit.\n"

local function types(extended: boolean, skilled: boolean, contracts: boolean, camp: boolean): string
	local fields = {
		"export type Quantity = { item: string, quantity: number }",
		if extended
			then "export type Item = { id: string, name: string, stackMax: number, weightMilli: number, maxDurabilityMilli: number?, foodEffects: FoodEffects?, tags: { string } }"
			else "export type Item = { id: string, name: string, stackMax: number, weightMilli: number, maxDurabilityMilli: number?, tags: { string } }",
		if skilled
			then "export type Recipe = { id: string, craftMillis: number, inputs: { Quantity }, outputs: { Quantity }, station: string?, requiredToolTag: string?, slots: { Slot }?, tier: number?, latents: { string }?, skill: SkillGrant? }"
			else "export type Recipe = { id: string, craftMillis: number, inputs: { Quantity }, outputs: { Quantity }, station: string?, requiredToolTag: string?, slots: { Slot }?, tier: number?, latents: { string }?, skill: nil }",
		if skilled
			then "export type Node = { id: string, harvest: { Quantity }, respawnMillis: number, skill: SkillGrant? }"
			else "export type Node = { id: string, harvest: { Quantity }, respawnMillis: number, skill: nil }",
		"export type Slot = { tag: string, minGrade: number, quantity: number }",
		"export type Structure = { id: string, footprintX: number, footprintZ: number, station: boolean, cost: { Quantity }, tier: number? }",
		"export type Wildlife = { id: string, behavior: string, senseStuds: number?, fleeStuds: number?, warnStuds: number?, attackStuds: number?, leashStuds: number?, telegraphMillis: number?, cooldownMillis: number?, flag: string?, dangerBand: number? }",
		"export type Capability = { mode: string, actionVersion: number, saveVersion: number, contentVersion: number?, actions: { string }, features: { declared: { string }, implemented: { string } } }",
		"export type Content = {",
		"\tversion: number,",
		"\trules: { [string]: string },",
		"\tlimits: { [string]: number },",
		"\ttags: { string },",
		"\titems: { Item },",
		"\trecipes: { Recipe },",
		"\tnodes: { Node },",
		"\tstructures: { Structure },",
		"\twildlife: { Wildlife },",
		"\tcapability: Capability,",
	}
	if extended then
		table.insert(
			fields,
			1,
			"export type FoodEffects = { hungerMilli: number, healthMilli: number, fatigueMilli: number }"
		)
		table.insert(
			fields,
			2,
			"export type VitalsConfig = { hungerMillisPerUnit: number, fatigueMilliPerAction: number, restMilliPerSecond: number, starvationMillisPerUnit: number, exposureRiseTier1MilliPerSecond: number?, exposureRiseTier2MilliPerSecond: number?, exposureRiseTier3MilliPerSecond: number?, exposureRecoverMilliPerSecond: number?, exposureDamageMillisPerUnit: number?, staminaRegenMilliPerSecond: number?, staminaCostMilliPerAction: number?, respawnDelayMillis: number? }"
		)
		table.insert(fields, "\tvitals: VitalsConfig?,")
	end
	if skilled then
		-- Only packs that declare skills get the extra types, so every existing
		-- pack's generated SurvivalContent.luau stays byte-identical.
		table.insert(fields, 1, "export type SkillGrant = { id: string, xp: number }")
		table.insert(
			fields,
			2,
			"export type Skills = { baseStep: number, disciplines: { { id: string, thresholds: { number }, tools: { { item: string, tier: number } } } } }"
		)
		table.insert(fields, "\tskills: Skills?,")
	else
		-- Content.Document declares optional skill fields; keep the generated table
		-- type assignable to it without emitting skill types.
		table.insert(fields, "\tskills: nil,")
	end
	if contracts then
		local at = table.find(fields, "export type Content = {") :: number
		for offset, line in
			{
				"export type SponsorBundle = { tier: number, items: { Quantity } }",
				"export type Faction = { id: string, name: string, trustThresholds: { number }, bundles: { SponsorBundle } }",
				"export type ContractEntry = { id: string, faction: string, pool: string, deliver: { Quantity }, reward: { Quantity }, trust: number, coins: number? }",
				"export type ContractCatalog = { factions: { Faction }, entries: { ContractEntry }, firstDay: { string }, dailyCount: number, swapCooldownMillis: number, dayMillis: number }",
			}
		do
			table.insert(fields, at + offset - 1, line)
		end
		table.insert(fields, "\tcontracts: ContractCatalog?,")
	else
		-- Content.Document declares an optional contracts field; keep the generated
		-- table type assignable to it without emitting contract types.
		table.insert(fields, "\tcontracts: nil,")
	end
	if camp then
		local at = table.find(fields, "export type Content = {") :: number
		table.insert(
			fields,
			at,
			"export type CampCatalog = { leagueRung: number, rungs: { { rung: number, completions: number, facility: string } }, projects: { { id: string, rung: number, cost: { Quantity } } } }"
		)
		table.insert(fields, "\tcamp: CampCatalog?,")
	else
		-- Content.Document declares an optional camp field; keep the generated table
		-- type assignable to it without emitting camp types.
		table.insert(fields, "\tcamp: nil,")
	end
	table.insert(fields, "}")
	return table.concat(fields, "\n")
end

export type Rendered = { path: string, content: string }

-- List literals propagate their declared element type into every row. Explicit
-- numeric keys instead infer an exact first-row shape before checking the list.
local function serializeV2(value: any, used: { [string]: boolean }, descriptor: string?): string
	if descriptor and descriptor:sub(1, 1) == "?" then
		descriptor = descriptor:sub(2)
	end
	if type(value) ~= "table" then
		return contract.serialize(value)
	end
	local fields = {}
	if #value > 0 then
		for _, entry in value do
			local element = if descriptor and descriptor:sub(1, 2) == "[]" then descriptor:sub(3) else nil
			table.insert(fields, serializeV2(entry, used, element))
		end
	else
		local keys = {}
		for key in value do
			table.insert(keys, key)
		end
		table.sort(keys)
		for _, key in keys do
			local field = if key:match("^[%a_][%w_]*$") then key else "[" .. contract.serialize(key) .. "]"
			local child = if descriptor then ContentV2.descriptor(descriptor, key) else nil
			if descriptor == nil and table.find(ContentV2.SECTIONS, key) then
				child = "[]" .. key
			end
			table.insert(fields, field .. "=" .. serializeV2(value[key], used, child))
		end
	end
	local literal = "{" .. table.concat(fields, ",") .. "}"
	if descriptor and ContentV2.isObject(descriptor) then
		used[descriptor] = true
	end
	return if descriptor and ContentV2.isObject(descriptor)
		then "v2_" .. descriptor .. "(" .. literal .. ")"
		else literal
end

--- Renders the canonical document plus the resolved capability descriptor.
--- `mode` selects which descriptor is embedded, so generated source always
--- states which features are actually backed by a mechanism.
function M.render(document: Content.Document, mode: string): string
	local descriptor = Capability.describe(mode :: any)
	local skilled = document.skills ~= nil
	local extended = document.vitals ~= nil or skilled
	local hasContracts = document.contracts ~= nil
	local hasCamp = document.camp ~= nil
	for _, item in document.items do
		if item.foodEffects ~= nil then
			extended = true
			break
		end
	end
	local payload = {
		version = document.version,
		rules = document.rules,
		limits = document.limits,
		vitals = document.vitals,
		tags = document.tags,
		items = document.items,
		recipes = document.recipes,
		nodes = document.nodes,
		structures = document.structures,
		wildlife = document.wildlife,
		skills = document.skills,
		contracts = document.contracts,
		camp = document.camp,
		capability = {
			mode = descriptor.mode,
			actionVersion = descriptor.actionVersion,
			saveVersion = descriptor.saveVersion,
			contentVersion = descriptor.contentVersion,
			actions = descriptor.actions,
			features = {
				declared = descriptor.features.declared,
				implemented = descriptor.features.implemented,
			},
		},
	}
	local source = HEADER
	local typeSource = types(extended, skilled, hasContracts, hasCamp)
	if document.version == 2 then
		typeSource = typeSource:gsub(
			"export type Wildlife = {",
			"export type Wildlife = { mount: { enabled: boolean, cargoSlots: number, walkSpeed: number, runSpeed: number, stamina: number }?,",
			1
		)
	end
	if document.version == 2 then
		for _, section in ContentV2.SECTIONS do
			(payload :: any)[section] = (document :: any)[section]
		end
		local extra = ""
		for _, section in ContentV2.SECTIONS do
			extra ..= "\t" .. section .. ": { V2_" .. section .. " }?,\n"
		end
		typeSource = ContentV2.types() .. "\n" .. typeSource:sub(1, -2) .. extra .. "}"
	end
	local used: { [string]: boolean } = {}
	local serialized = if document.version == 2 then serializeV2(payload, used) else contract.serialize(payload)
	if document.version == 2 then
		typeSource ..= "\n" .. ContentV2.constructors(used)
	end
	source ..= typeSource .. "\nlocal content: Content = " .. serialized .. "\nreturn content\n"
	if extended or hasContracts or hasCamp or document.version == 2 then
		for _ = 1, 2 do
			local formatter = process.create("stylua", { "--config-path", "stylua.toml", "-" })
			formatter.stdin:write(source)
			formatter.stdin:close()
			source = formatter.stdout:readToEnd()
			local errors = formatter.stderr:readToEnd()
			assert(formatter:status().ok, errors)
		end
	end
	return source
end

--- Validates, canonicalizes and renders in one step. Returns `(nil, errors)`
--- when the source document is malformed, so no caller can publish a file
--- built from content that failed validation.
function M.build(raw: any, mode: string): (Rendered?, { string })
	local document, errors = Content.canonicalize(raw)
	if document == nil then
		return nil, errors
	end
	local resolved, reason = Capability.modeOf(mode)
	if resolved == nil then
		return nil, { reason :: string }
	end
	if resolved == "wave" then
		return nil, { "content: the wave mode declares no content catalog" }
	end
	return { path = "src/shared/" .. M.OUTPUT_NAME, content = M.render(document, resolved) }, {}
end

return M
