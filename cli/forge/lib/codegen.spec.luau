--!strict
-- Specs for codegen: byte-stable EconConfig output that covers every egg id.

local serde = require("@lune/serde")
local codegen = require("./codegen")

local ECON_YAML = table.concat({
	"currencies:",
	"  - id: Coins",
	"    kind: free",
	"    starting: 100",
	"incubators:",
	"  max: 3",
	"eggs:",
	"  - id: ember",
	"    displayName: Ember Egg",
	"    price: 50",
	"    hatchSeconds: 5",
	"    pool:",
	"      - id: pyro-pup",
	"        weight: 70",
	"      - id: magma-mauler",
	"        weight: 30",
	"  - id: tidal",
	"    displayName: Tidal Egg",
	"    price: 250",
	"    hatchSeconds: 15",
	"    pool:",
	"      - id: reef-runner",
	"        weight: 100",
	"kaiju:",
	"  - id: pyro-pup",
	"    displayName: Pyro Pup",
	"    rarity: Common",
	"    coinsPerSecond: 1",
	"  - id: reef-runner",
	"    displayName: Reef Runner",
	"    rarity: Common",
	"    coinsPerSecond: 4",
	"",
}, "\n")

return {
	["generation is byte-stable across runs"] = function()
		local first = codegen.generate(ECON_YAML)
		local second = codegen.generate(ECON_YAML)
		assert(first == second, "two runs over the same yaml must produce identical text")
	end,

	["output contains every egg id"] = function()
		local output = codegen.generate(ECON_YAML)
		local econ = serde.decode("yaml", ECON_YAML)
		local eggCount = 0
		for _, egg in econ.eggs do
			eggCount += 1
			assert(
				string.find(output, '["' .. egg.id .. '"]', 1, true) ~= nil,
				"generated output is missing egg id " .. egg.id
			)
		end
		assert(eggCount == #econ.eggs and eggCount > 0, "sample yaml should contain eggs")
	end,

	["output declares the strict directive and the generated header"] = function()
		local output = codegen.generate(ECON_YAML)
		assert(string.sub(output, 1, 9) == "--!strict", "first line must be --!strict")
		assert(
			string.find(output, "-- GENERATED by forge codegen from econ.yml. Do not edit.", 1, true) ~= nil,
			"missing generated header comment"
		)
	end,

	["output exports the economy fields"] = function()
		local output = codegen.generate(ECON_YAML)
		for _, field in { "currency", "startingCoins", "maxIncubators", "eggs", "eggOrder", "kaiju" } do
			assert(string.find(output, field, 1, true) ~= nil, "missing exported field " .. field)
		end
		assert(string.find(output, "startingCoins = 100", 1, true) ~= nil, "startingCoins should read 100")
		assert(string.find(output, 'currency = "Coins"', 1, true) ~= nil, 'currency should read "Coins"')
		assert(string.find(output, "maxIncubators = 3", 1, true) ~= nil, "maxIncubators should read 3")
		assert(
			string.find(output, "pricing = { growthPerOwned = 0 }", 1, true) ~= nil,
			"a missing pricing section defaults growthPerOwned to 0"
		)
		assert(
			string.find(output, "income = { activeSlots = 0 }", 1, true) ~= nil,
			"a missing income section defaults activeSlots to unlimited (0)"
		)
	end,

	["optional pricing and income sections are emitted"] = function()
		local yaml = table.concat({
			"currencies:",
			"  - id: Coins",
			"    starting: 100",
			"pricing:",
			"  growthPerOwned: 0.15",
			"income:",
			"  activeSlots: 8",
			"",
		}, "\n")
		local output = codegen.generate(yaml)
		assert(string.find(output, "pricing = { growthPerOwned = 0.15 }", 1, true) ~= nil, "growth is emitted")
		assert(string.find(output, "income = { activeSlots = 8 }", 1, true) ~= nil, "slots are emitted")
	end,

	["an empty genre template still generates"] = function()
		local output = codegen.generate("currencies: []\nsources: []\nsinks: []\n")
		assert(string.find(output, "return EconConfig", 1, true) ~= nil, "should still emit a module")
		assert(string.find(output, "eggOrder = {}", 1, true) ~= nil, "eggOrder should be empty")
	end,

	["F7: a present but non-numeric econ value errors instead of silently becoming 0"] = function()
		local yaml = table.concat({
			"currencies:",
			"  - id: Coins",
			"    starting: 100",
			"eggs:",
			"  - id: e",
			"    price: 1OO", -- letter O typo, not the digit 0
			"",
		}, "\n")
		local ok, err = pcall(codegen.generate, yaml)
		assert(not ok, "a non-numeric price must error instead of generating price = 0")
		assert(
			string.find(tostring(err), "eggs%[e%]%.price") ~= nil,
			"error must name the offending field: " .. tostring(err)
		)
	end,

	["F7: an absent numeric field still falls back to its default (not an error)"] = function()
		local yaml = table.concat({
			"currencies:",
			"  - id: Coins",
			"    starting: 100",
			"eggs:",
			"  - id: e",
			"    displayName: E",
			"",
		}, "\n")
		local output = codegen.generate(yaml)
		assert(string.find(output, "price = 0", 1, true) ~= nil, "a missing price still defaults to 0")
	end,
}
