--!strict
-- codegen: pure econ.yml -> EconConfig.luau text generation, shared by `forge codegen` and the check [econ] stage.

local serde = require("@lune/serde")
local genrecontract = require("./genrecontract")
local registryLib = require("./genreregistry")
local project = require("./genreproject")

local M = {}
function M.generateDocument(text: string, registry: registryLib.Registry?): (string, string)
	local doc = serde.decode("yaml", text)
	assert(type(doc) == "table", "econ.yml must decode to a table")
	if doc.genre_contract == nil then
		return "EconConfig.luau", M.generate(text)
	end
	assert(registry ~= nil, "genre config requires registry")
	local errors = genrecontract.validatePack(doc.genre_contract, (registry :: registryLib.Registry).runtimes)
	assert(#errors == 0, table.concat(errors, "; "))
	return "GenreConfig.luau", project.renderConfig(doc.genre_contract)
end

local GENERATED_HEADER = "-- GENERATED by forge codegen from econ.yml. Do not edit."
local COLUMN_WIDTH = 120

local function quote(value: string): string
	local escaped = string.gsub(value, "\\", "\\\\")
	escaped = string.gsub(escaped, '"', '\\"')
	escaped = string.gsub(escaped, "\n", "\\n")
	escaped = string.gsub(escaped, "\r", "\\r")
	return '"' .. escaped .. '"'
end

local function toString(value: any, fallback: string): string
	if value == nil then
		return fallback
	end
	return tostring(value)
end

local function toNumber(value: any, fallback: number, context: string): number
	if value == nil then
		return fallback
	end
	if typeof(value) == "number" then
		return value
	end
	-- The field is present but not numeric (for example a typo like "1OO"): a
	-- silent 0 would turn it into a free egg or a zero-cost/zero-income entry
	-- with no warning, so this is a hard error instead of a fallback.
	error("econ.yml: " .. context .. " must be a number, got " .. tostring(value))
end

local function formatNumber(value: number): string
	if value % 1 == 0 and math.abs(value) < 9007199254740992 then
		return string.format("%d", value)
	end
	return tostring(value)
end

local function field(value: any, key: string): any
	if typeof(value) == "table" then
		return value[key]
	end
	return nil
end

-- Reads a YAML sequence (kept in document order) or mapping (keys sorted) into a
-- list of { key, value } pairs so generation stays byte-stable.
local function readEntries(value: any): { { key: any, value: any } }
	local entries: { { key: any, value: any } } = {}
	if typeof(value) ~= "table" then
		return entries
	end
	if value[1] ~= nil then
		for index = 1, #value do
			table.insert(entries, { key = index, value = value[index] })
		end
		return entries
	end
	local keys: { any } = {}
	for key in value do
		table.insert(keys, key)
	end
	table.sort(keys, function(a, b)
		return tostring(a) < tostring(b)
	end)
	for _, key in keys do
		table.insert(entries, { key = key, value = value[key] })
	end
	return entries
end

local function entryId(entry: { key: any, value: any }): string
	local rawId = field(entry.value, "id")
	if rawId ~= nil and tostring(rawId) ~= "" then
		return tostring(rawId)
	end
	return tostring(entry.key)
end

local function renderStringArray(name: string, items: { string }, lines: { string })
	local single = "\t" .. name .. " = {"
	if #items > 0 then
		single ..= " "
		for index, item in items do
			if index > 1 then
				single ..= ", "
			end
			single ..= quote(item)
		end
		single ..= " "
	end
	single ..= "},"
	if #single <= COLUMN_WIDTH then
		table.insert(lines, single)
		return
	end
	table.insert(lines, "\t" .. name .. " = {")
	for _, item in items do
		table.insert(lines, "\t\t" .. quote(item) .. ",")
	end
	table.insert(lines, "\t},")
end

--- Generates the EconConfig.luau source for an econ.yml document.
--- Deterministic: sequence order is preserved and mapping keys are sorted, so the
--- same YAML always produces byte-identical output.
function M.generate(econYaml: string): string
	local econ = serde.decode("yaml", econYaml)
	if typeof(econ) ~= "table" then
		error("econ.yml must decode to a table")
	end

	local currencies = readEntries(field(econ, "currencies"))
	local firstCurrency: any = nil
	if #currencies > 0 then
		firstCurrency = currencies[1].value
	end
	local currencyId = if #currencies > 0 then entryId(currencies[1]) else ""
	local startingCoins = toNumber(field(firstCurrency, "starting"), 0, "currencies[1].starting")
	local maxIncubators = toNumber(field(field(econ, "incubators"), "max"), 0, "incubators.max")

	-- Optional economy knobs. A missing section keeps the pre-sink defaults.
	local growthPerOwned = 0
	local pricing = field(econ, "pricing")
	if typeof(pricing) == "table" then
		local raw = toNumber(field(pricing, "growthPerOwned"), 0, "pricing.growthPerOwned")
		if raw > 0 then
			growthPerOwned = raw
		end
	end
	local activeSlots = 0 -- 0 means "no slot limit"
	local income = field(econ, "income")
	if typeof(income) == "table" then
		local raw = toNumber(field(income, "activeSlots"), 0, "income.activeSlots")
		if raw >= 1 then
			activeSlots = math.floor(raw)
		end
	end

	-- Gamepass tuning lives next to its gamepass entry in monetization.gamepasses;
	-- a pack without the entry keeps the genre's original 2x / +4 effects.
	local coins2xMultiplier = 2
	local vipSlotBonus = 4
	for _, entry in readEntries(field(field(econ, "monetization"), "gamepasses")) do
		local key = field(entry.value, "key")
		if key == "coins2x" then
			coins2xMultiplier =
				toNumber(field(entry.value, "multiplier"), 2, "monetization.gamepasses[coins2x].multiplier")
		elseif key == "vipSlots" then
			vipSlotBonus = toNumber(field(entry.value, "slotBonus"), 4, "monetization.gamepasses[vipSlots].slotBonus")
		end
	end

	local eggLines: { string } = {}
	local eggOrder: { string } = {}
	for _, entry in readEntries(field(econ, "eggs")) do
		local id = entryId(entry)
		local egg = entry.value
		table.insert(eggOrder, id)
		table.insert(eggLines, "\t\t[" .. quote(id) .. "] = {")
		table.insert(eggLines, "\t\t\tid = " .. quote(id) .. ",")
		table.insert(eggLines, "\t\t\tdisplayName = " .. quote(toString(field(egg, "displayName"), id)) .. ",")
		table.insert(
			eggLines,
			"\t\t\tprice = " .. formatNumber(toNumber(field(egg, "price"), 0, "eggs[" .. id .. "].price")) .. ","
		)
		table.insert(
			eggLines,
			"\t\t\thatchSeconds = "
				.. formatNumber(toNumber(field(egg, "hatchSeconds"), 0, "eggs[" .. id .. "].hatchSeconds"))
				.. ","
		)
		local poolEntries = readEntries(field(egg, "pool"))
		if #poolEntries == 0 then
			-- stylua collapses empty tables, so emit them on one line
			table.insert(eggLines, "\t\t\tpool = {},")
		else
			table.insert(eggLines, "\t\t\tpool = {")
			for _, poolEntry in poolEntries do
				local poolId = entryId(poolEntry)
				local weight = formatNumber(
					toNumber(field(poolEntry.value, "weight"), 0, "eggs[" .. id .. "].pool[" .. poolId .. "].weight")
				)
				local inline = "\t\t\t\t{ id = " .. quote(poolId) .. ", weight = " .. weight .. " },"
				if #inline <= COLUMN_WIDTH then
					table.insert(eggLines, inline)
				else
					table.insert(eggLines, "\t\t\t\t{")
					table.insert(eggLines, "\t\t\t\t\tid = " .. quote(poolId) .. ",")
					table.insert(eggLines, "\t\t\t\t\tweight = " .. weight .. ",")
					table.insert(eggLines, "\t\t\t\t},")
				end
			end
			table.insert(eggLines, "\t\t\t},")
		end
		table.insert(eggLines, "\t\t},")
	end

	local kaijuLines: { string } = {}
	for _, entry in readEntries(field(econ, "kaiju")) do
		local id = entryId(entry)
		local kaiju = entry.value
		table.insert(kaijuLines, "\t\t[" .. quote(id) .. "] = {")
		table.insert(kaijuLines, "\t\t\tid = " .. quote(id) .. ",")
		table.insert(kaijuLines, "\t\t\tdisplayName = " .. quote(toString(field(kaiju, "displayName"), id)) .. ",")
		table.insert(kaijuLines, "\t\t\trarity = " .. quote(toString(field(kaiju, "rarity"), "Common")) .. ",")
		table.insert(
			kaijuLines,
			"\t\t\tcoinsPerSecond = "
				.. formatNumber(toNumber(field(kaiju, "coinsPerSecond"), 0, "kaiju[" .. id .. "].coinsPerSecond"))
				.. ","
		)
		table.insert(kaijuLines, "\t\t},")
	end

	local lines: { string } = {}
	table.insert(lines, "--!strict")
	table.insert(lines, GENERATED_HEADER)
	table.insert(lines, "")
	table.insert(lines, "export type EggPoolEntry = {")
	table.insert(lines, "\tid: string,")
	table.insert(lines, "\tweight: number,")
	table.insert(lines, "}")
	table.insert(lines, "")
	table.insert(lines, "export type EggConfig = {")
	table.insert(lines, "\tid: string,")
	table.insert(lines, "\tdisplayName: string,")
	table.insert(lines, "\tprice: number,")
	table.insert(lines, "\thatchSeconds: number,")
	table.insert(lines, "\tpool: { EggPoolEntry },")
	table.insert(lines, "}")
	table.insert(lines, "")
	table.insert(lines, "export type KaijuConfig = {")
	table.insert(lines, "\tid: string,")
	table.insert(lines, "\tdisplayName: string,")
	table.insert(lines, "\trarity: string,")
	table.insert(lines, "\tcoinsPerSecond: number,")
	table.insert(lines, "}")
	table.insert(lines, "")
	table.insert(lines, "export type PricingConfig = {")
	table.insert(lines, "\tgrowthPerOwned: number,")
	table.insert(lines, "}")
	table.insert(lines, "")
	table.insert(lines, "export type IncomeConfig = {")
	table.insert(lines, "\tactiveSlots: number,")
	table.insert(lines, "}")
	table.insert(lines, "")
	table.insert(lines, "export type PassEffectsConfig = {")
	table.insert(lines, "\tcoins2xMultiplier: number,")
	table.insert(lines, "\tvipSlotBonus: number,")
	table.insert(lines, "}")
	table.insert(lines, "")
	table.insert(lines, "export type EconData = {")
	table.insert(lines, "\tcurrency: string,")
	table.insert(lines, "\tstartingCoins: number,")
	table.insert(lines, "\tmaxIncubators: number,")
	table.insert(lines, "\tpricing: PricingConfig,")
	table.insert(lines, "\tincome: IncomeConfig,")
	table.insert(lines, "\tpassEffects: PassEffectsConfig,")
	table.insert(lines, "\teggs: { [string]: EggConfig },")
	table.insert(lines, "\teggOrder: { string },")
	table.insert(lines, "\tkaiju: { [string]: KaijuConfig },")
	table.insert(lines, "}")
	table.insert(lines, "")
	table.insert(lines, "local EconConfig: EconData = {")
	table.insert(lines, "\tcurrency = " .. quote(currencyId) .. ",")
	table.insert(lines, "\tstartingCoins = " .. formatNumber(startingCoins) .. ",")
	table.insert(lines, "\tmaxIncubators = " .. formatNumber(maxIncubators) .. ",")
	table.insert(lines, "\tpricing = { growthPerOwned = " .. formatNumber(growthPerOwned) .. " },")
	table.insert(lines, "\tincome = { activeSlots = " .. formatNumber(activeSlots) .. " },")
	table.insert(
		lines,
		"\tpassEffects = { coins2xMultiplier = "
			.. formatNumber(coins2xMultiplier)
			.. ", vipSlotBonus = "
			.. formatNumber(vipSlotBonus)
			.. " },"
	)
	table.insert(lines, "\teggs = {")
	if #eggLines == 0 then
		table.remove(lines, #lines)
		table.insert(lines, "\teggs = {},")
	else
		for _, line in eggLines do
			table.insert(lines, line)
		end
		table.insert(lines, "\t},")
	end
	renderStringArray("eggOrder", eggOrder, lines)
	table.insert(lines, "\tkaiju = {")
	if #kaijuLines == 0 then
		table.remove(lines, #lines)
		table.insert(lines, "\tkaiju = {},")
	else
		for _, line in kaijuLines do
			table.insert(lines, line)
		end
		table.insert(lines, "\t},")
	end
	table.insert(lines, "}")
	table.insert(lines, "")
	table.insert(lines, "return EconConfig")
	table.insert(lines, "")
	return table.concat(lines, "\n")
end

return M
