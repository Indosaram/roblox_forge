--!strict
local fs = require("@lune/fs")
local process = require("@lune/process")
local serde = require("@lune/serde")
local contract = require("./genrecontract")
local Content = require("../../../core/domain/survival/Content")
local WorldKit = require("../../../core/ui-kit/genre/WorldKit")
local registryLib = require("./genreregistry")
local scaffold = require("./scaffold")
local M = {}
function M.absolute(path: string): string
	local normalized = string.gsub(path, "\\", "/")
	if not string.match(normalized, "^%a:/") and string.sub(normalized, 1, 1) ~= "/" then
		normalized = string.gsub(process.cwd, "\\", "/") .. "/" .. normalized
	end
	local prefix = string.match(normalized, "^%a:") or ""
	local parts = {}
	for part in string.gmatch(string.sub(normalized, #prefix + 1), "[^/]+") do
		if part == ".." then
			assert(#parts > 0, "path escapes root")
			table.remove(parts)
		elseif part ~= "." then
			table.insert(parts, part)
		end
	end
	return prefix .. "/" .. table.concat(parts, "/")
end
function M.relative(from: string, destination: string): string
	local a, b = {}, {}
	for part in string.gmatch(M.absolute(from), "[^/]+") do
		table.insert(a, part)
	end
	for part in string.gmatch(M.absolute(destination), "[^/]+") do
		table.insert(b, part)
	end
	if string.lower(a[1]) ~= string.lower(b[1]) then
		return M.absolute(destination)
	end
	local i = 1
	while a[i] and b[i] and string.lower(a[i]) == string.lower(b[i]) do
		i += 1
	end
	local out = {}
	for _ = i, #a do
		table.insert(out, "..")
	end
	for j = i, #b do
		table.insert(out, b[j])
	end
	return table.concat(out, "/")
end
function M.renderConfig(pack: any): string
	local survival = pack.configs["survival-coop"]
	if survival and survival.mode == "crafting" and survival.inventory then
		local canonical, errors = Content.canonicalize(survival.inventory.content)
		assert(canonical, table.concat(errors, "; "))
		pack = table.clone(pack)
		pack.configs = table.clone(pack.configs)
		survival = table.clone(survival)
		survival.inventory = table.clone(survival.inventory)
		local externalContent: any = canonical
		externalContent.survival_content = canonical.version
		externalContent.version = nil
		survival.inventory.content = externalContent
		pack.configs["survival-coop"] = survival
		local lines = {
			"--!strict",
			"-- GENERATED by forge codegen from econ.yml. Do not edit.",
			"export type PackConfig = {api:number,order:{string},configs:{[string]:{[string]:any}},recipe:string?}",
		}
		local content = survival.inventory.content
		local declarations = {
			items = "{ {id:string,name:string,stackMax:number,weightMilli:number,maxDurabilityMilli:number?,tags:{string},foodEffects:{hungerMilli:number,healthMilli:number,fatigueMilli:number}?} }",
			recipes = "{ {id:string,craftMillis:number,inputs:{{item:string,quantity:number}},outputs:{{item:string,quantity:number}},station:string?,requiredToolTag:string?} }",
			wildlife = "{ {id:string,behavior:string,senseStuds:number?,fleeStuds:number?,warnStuds:number?,attackStuds:number?,leashStuds:number?,telegraphMillis:number?,cooldownMillis:number?} }",
		}
		local serialized = contract.serialize(pack)
		for _, key in { "items", "recipes", "wildlife" } do
			local value = contract.serialize(content[key])
			table.insert(lines, "local " .. key .. ": " .. declarations[key] .. " = " .. value)
			local startAt, endAt = string.find(serialized, '["' .. key .. '"]=' .. value, 1, true)
			assert(startAt and endAt, "missing crafting catalog field")
			serialized = string.sub(serialized, 1, startAt - 1)
				.. '["'
				.. key
				.. '"]='
				.. key
				.. string.sub(serialized, endAt + 1)
		end
		table.insert(lines, "local config: PackConfig = " .. serialized .. "\nreturn config\n")
		local formatter = process.create("stylua", {
			"--config-path",
			"stylua.toml",
			"--stdin-filepath",
			"GenreConfig.luau",
			"-",
		})
		formatter.stdin:write(table.concat(lines, "\n"))
		formatter.stdin:close()
		local formatted = formatter.stdout:readToEnd()
		local formatterErrors = formatter.stderr:readToEnd()
		assert(formatter:status().ok, formatterErrors)
		local stabilized = process.create("stylua", { "--config-path", "stylua.toml", "-" })
		stabilized.stdin:write(formatted)
		stabilized.stdin:close()
		local stableSource = stabilized.stdout:readToEnd()
		local stableErrors = stabilized.stderr:readToEnd()
		assert(stabilized:status().ok, stableErrors)
		return stableSource
	end
	return "--!strict\n-- GENERATED by forge codegen from econ.yml. Do not edit.\nexport type PackConfig = {api:number,order:{string},configs:{[string]:{[string]:any}},recipe:string?}\nlocal config: PackConfig = "
		.. contract.serialize(pack)
		.. "\nreturn config\n"
end
function M.coreRoot(registry: registryLib.Registry): string
	local sibling = (string.match(registry.root, "^(.*)/[^/]+$") or "") .. "/core"
	return if fs.isFile(sibling .. "/forge-package.yml") then sibling else M.absolute("core")
end
--- Builds the pack's default.project.json. `world` names the baked world model a
--- genre without a world override ships: it is mounted under Workspace, and the
--- pack's server entry is the world binder that starts the server with no starter
--- world.
function M.project(
	input: contract.GenerateInput,
	order: { string },
	destination: string,
	registry: registryLib.Registry,
	world: { path: string, name: string }?
): string
	local doc = serde.decode("json", scaffold.projectJson(input.slug, input.pascal, order))
	local tree = doc.tree.ReplicatedStorage.Forge
	for _, name in { "domain", "infra", "anticheat", "ui-kit" } do
		tree.core[name]["$path"] = M.relative(destination, M.coreRoot(registry) .. "/" .. name)
	end
	for _, id in order do
		tree.genres[id].module["$path"] = M.relative(destination, registry.packages[id].path .. "/module")
	end
	for _, id in order do
		local recipe = registry.runtimes[id].recipe
		if recipe then
			for _, partner in recipe.partners do
				if tree.genres[partner] == nil then
					tree.genres[partner] = {
						["$className"] = "Folder",
						module = { ["$path"] = M.relative(destination, registry.packages[partner].path .. "/module") },
					}
				end
			end
		end
	end
	if not (#order == 1 and registry.packages[order[1]].generator.legacy ~= nil) then
		doc.tree.ServerScriptService.GenreHooks = { ["$path"] = "src/server/GenreHooks.luau" }
		doc.tree.ServerScriptService.PersistenceConfig = { ["$path"] = "src/server/PersistenceConfig.luau" }
	end
	if world ~= nil then
		-- The baked world replaces the generic starter world, and its entry point owns
		-- the server start, so the plain server script is not generated.
		doc.tree.ServerScriptService[input.pascal .. "Server"] = nil
		doc.tree.ServerScriptService[input.pascal .. "World"] =
			{ ["$path"] = "src/server/" .. input.pascal .. "World.server.luau" }
		doc.tree.Workspace = { ["$className"] = "Workspace", [world.name] = { ["$path"] = world.path } }
	end
	-- The environment is part of the place, not a runtime afterthought: the same
	-- numbers `WorldKit.applyEnvironment` sets are baked here from one table, so a
	-- freshly built pack has sky and light before any script runs, and the build's
	-- own instance inspection proves they are present in the artifact.
	--
	-- Colour is the one place the two encodings differ: the runtime path goes
	-- through `Color3.fromRGB` (0..255) while a Rojo project file's `Color3` takes
	-- 0..1 components, so `WorldKit.rojoColor3` converts. Passing the 0..255
	-- numbers straight through clamps every channel to 1 and renders the whole
	-- place flat white.
	local environment = WorldKit.ENVIRONMENT
	local atmosphere = environment.atmosphere
	doc.tree.Lighting = {
		["$className"] = "Lighting",
		["$properties"] = {
			Technology = "ShadowMap",
			GlobalShadows = true,
			ClockTime = environment.clockTime,
			GeographicLatitude = environment.geographicLatitude,
			Brightness = environment.brightness,
			ExposureCompensation = environment.exposureCompensation,
			EnvironmentDiffuseScale = environment.environmentDiffuseScale,
			EnvironmentSpecularScale = environment.environmentSpecularScale,
			Ambient = WorldKit.rojoColor3(environment.ambient),
			OutdoorAmbient = WorldKit.rojoColor3(environment.outdoorAmbient),
		},
		ForgeAtmosphere = {
			["$className"] = "Atmosphere",
			["$properties"] = {
				Density = atmosphere.density,
				Offset = atmosphere.offset,
				Glare = atmosphere.glare,
				Haze = atmosphere.haze,
				Color = WorldKit.rojoColor3(atmosphere.color),
				Decay = WorldKit.rojoColor3(atmosphere.decay),
			},
		},
		ForgeSky = { ["$className"] = "Sky", ["$properties"] = environment.sky },
	}
	return serde.encode("json", doc, true) .. "\n"
end
return M
