--!strict
-- WorldLayout: pure world data for Kaiju Egg Raiders (no Roblox APIs). Generated by
-- forge plan; WorldBuilder turns this into the arena, team bases with
-- incubators, and parade slots.

export type Vec = { x: number, y: number, z: number }

export type ParadeLayout = {
	name: string,
	positions: { Vec },
}

export type BaseLayout = {
	team: string,
	center: Vec,
	size: Vec,
	spawn: Vec,
	spawnTeamColor: string,
	incubators: { Vec },
	vault: Vec,
	parade: ParadeLayout,
	shop: Vec,
	color: { r: number, g: number, b: number },
}

export type ArenaLayout = {
	center: Vec,
	radius: number,
	covers: { { position: Vec, size: Vec } },
	torches: { Vec },
}

export type Decoration = {
	kind: string,
	position: Vec,
	scale: Vec,
	seed: number,
}

export type Layout = {
	name: string,
	ground: { cells: number, cellSize: number, originX: number, originZ: number, y: number, thickness: number },
	bases: { BaseLayout },
	arena: ArenaLayout,
	decorations: { Decoration }?,
	flowers: { Decoration }?,
}

local INCUBATORS_PER_TEAM = 6
local PARADE_SLOTS = 6
local BASE_X = 70

local function vec(x: number, y: number, z: number): Vec
	return { x = x, y = y, z = z }
end

local TEAM_COLORS: { [string]: string } = {
	["Red"] = "Really red",
	["Blue"] = "Bright blue",
}

local TEAM_RGB: { [string]: { r: number, g: number, b: number } } = {
	["Red"] = { r = 200, g = 50, b = 50 },
	["Blue"] = { r = 50, g = 90, b = 210 },
}

-- Bases sit evenly spaced around a ring of radius BASE_X * (team count / 2),
-- so any number of teams (2, 3, 4, ...) gets a fair, symmetric layout.
local function base(team: string, index: number, teamCount: number): BaseLayout
	local angle = (index - 1) * (2 * math.pi / teamCount)
	local ringRadius = BASE_X * math.max(1, teamCount / 2)
	local cx = math.cos(angle) * ringRadius
	local cz = math.sin(angle) * ringRadius
	-- outward: unit vector from the ring center to this base; inward is its
	-- opposite, and (-inwardZ, inwardX) is the perpendicular ("sideways") axis.
	local outwardX, outwardZ = math.cos(angle), math.sin(angle)
	local inwardX, inwardZ = -outwardX, -outwardZ
	local sideX, sideZ = -inwardZ, inwardX

	local incubators: { Vec } = {}
	for i = 1, INCUBATORS_PER_TEAM do
		local t = (-(INCUBATORS_PER_TEAM - 1) / 2 + (i - 1)) * 12
		local offsetX, offsetZ = inwardX * 14 + sideX * t, inwardZ * 14 + sideZ * t
		table.insert(incubators, vec(cx + offsetX, 1, cz + offsetZ))
	end

	local positions: { Vec } = {}
	for k = 1, PARADE_SLOTS do
		local t = -16 + (k - 1) * 16
		local offsetX, offsetZ = outwardX * 16 + sideX * t, outwardZ * 16 + sideZ * t
		table.insert(positions, vec(cx + offsetX, 1, cz + offsetZ))
	end

	-- Spawn sits at the map edge (outward, away from the arena); the vault sits
	-- closer in (inward), so raiders always have farther to walk than defenders.
	local spawnOffsetX, spawnOffsetZ = outwardX * 20, outwardZ * 20
	local vaultOffsetX, vaultOffsetZ = inwardX * 22, inwardZ * 22
	local shopOffsetX, shopOffsetZ = inwardX * 16 + sideX * 20, inwardZ * 16 + sideZ * 20

	return {
		team = team,
		center = vec(cx, 0, cz),
		size = vec(56, 8, 56),
		spawn = vec(cx + spawnOffsetX, 3, cz + spawnOffsetZ),
		spawnTeamColor = TEAM_COLORS[team] or "Medium stone grey",
		incubators = incubators,
		vault = vec(cx + vaultOffsetX, 2, cz + vaultOffsetZ),
		parade = { name = "KaijuEggRaidersSlot", positions = positions },
		shop = vec(cx + shopOffsetX, 1, cz + shopOffsetZ),
		color = TEAM_RGB[team] or { r = 150, g = 150, b = 150 },
	}
end

local WorldLayout = {}

WorldLayout.name = "KaijuEggRaidersWorld"
WorldLayout.ground = { cells = 16, cellSize = 25, originX = -200, originZ = -200, y = -0.5, thickness = 1 }

local function arena(): ArenaLayout
	return {
		center = vec(0, 0, 0),
		radius = 40,
		covers = {
			{ position = vec(20, 3, 20), size = vec(8, 6, 2) },
			{ position = vec(-20, 3, -20), size = vec(8, 6, 2) },
			{ position = vec(20, 3, -20), size = vec(8, 6, 2) },
			{ position = vec(-20, 3, 20), size = vec(8, 6, 2) },
		},
		torches = { vec(40, 0, 0), vec(-40, 0, 0), vec(0, 0, 40), vec(0, 0, -40) },
	}
end

local bases: { BaseLayout } = {}
local TEAMS = {
	"Red",
	"Blue",
}
for index, teamName in TEAMS do
	table.insert(bases, base(teamName, index, #TEAMS))
end

local ARENA = arena()

local WorldBuilderMath = require("../../../../genres/collect-raid/module/WorldBuilderMath")

local DECOR_REGION = { minX = -190, maxX = 190, minZ = -190, maxZ = 190 }

-- Exclusion zones keep props off the arena, every base, every spawn, and the
-- base-to-arena lanes.
local function exclusionZones(): { WorldBuilderMath.ScatterZone }
	local zones: { WorldBuilderMath.ScatterZone } = {
		{ x = ARENA.center.x, z = ARENA.center.z, inner = 0, outer = ARENA.radius + 20 },
	}
	for _, b in bases do
		local half = b.size.x / 2
		local dx, dz = b.center.x - ARENA.center.x, b.center.z - ARENA.center.z
		local len = math.sqrt(dx * dx + dz * dz)
		local dirX, dirZ = if len > 1e-4 then dx / len else 1, if len > 1e-4 then dz / len else 0
		table.insert(zones, { x = b.center.x, z = b.center.z, inner = 0, outer = half + 19 })
		table.insert(zones, { x = b.spawn.x, z = b.spawn.z, inner = 0, outer = 14 })
		for k = 0, 1 do
			table.insert(zones, {
				x = b.center.x - dirX * (half + 5 + k * 12),
				z = b.center.z - dirZ * (half + 5 + k * 12),
				inner = 0,
				outer = 12,
			})
		end
	end
	return zones
end

local function baseRings(inner: number, outer: number): { WorldBuilderMath.ScatterZone }
	local zones: { WorldBuilderMath.ScatterZone } = {}
	for _, b in bases do
		table.insert(zones, { x = b.center.x, z = b.center.z, inner = inner, outer = outer })
	end
	return zones
end

local CRYSTAL_ZONES: { WorldBuilderMath.ScatterZone } = {
	{ x = ARENA.center.x, z = ARENA.center.z, inner = ARENA.radius + 32, outer = ARENA.radius + 60 },
}
for _, zone in baseRings(66, 92) do
	table.insert(CRYSTAL_ZONES, zone)
end

local DECOR_SPEC: WorldBuilderMath.ScatterSpec = {
	region = DECOR_REGION,
	exclusions = exclusionZones(),
	bands = {
		{
			kind = "Tree",
			count = 41,
			minSpacing = 16,
			scaleMin = 8,
			scaleMax = 14,
			yFactor = 0.95,
			edgeBias = 0.85,
			edgeWidth = 95,
		},
		{
			kind = "Rock",
			count = 28,
			minSpacing = 10,
			scaleMin = 3,
			scaleMax = 7,
			yFactor = 0.55,
			edgeBias = 0.35,
			edgeWidth = 70,
		},
		{
			kind = "Crystal",
			count = 13,
			minSpacing = 8,
			scaleMin = 3,
			scaleMax = 6,
			yFactor = 0.9,
			attractors = CRYSTAL_ZONES,
			attractorChance = 0.85,
		},
		{
			kind = "Crate",
			count = 9,
			minSpacing = 8,
			scaleMin = 3,
			scaleMax = 4,
			yFactor = 0.85,
			attractors = baseRings(66, 96),
			attractorChance = 0.9,
		},
	},
	maxAttempts = 4000,
}

-- Trees 45% / rocks 30% / crystals 15% / crates 10%, 91 total.
local decorations = WorldBuilderMath.scatter(DECOR_SPEC, 20260929)

local FLOWER_SPEC: WorldBuilderMath.ScatterSpec = {
	region = DECOR_REGION,
	exclusions = exclusionZones(),
	bands = {
		{
			kind = "Flower",
			count = 40,
			minSpacing = 13,
			scaleMin = 1.5,
			scaleMax = 2.5,
			yFactor = 0.4,
			edgeBias = 0.2,
			edgeWidth = 60,
		},
	},
	maxAttempts = 4000,
}

local flowers = WorldBuilderMath.scatter(FLOWER_SPEC, 76543)

WorldLayout.layout = {
	name = WorldLayout.name,
	ground = WorldLayout.ground,
	bases = bases,
	arena = ARENA,
	decorations = decorations,
	flowers = flowers,
} :: Layout

return WorldLayout
