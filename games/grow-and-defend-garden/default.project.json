{
  "name": "grow-and-defend-garden",
  "globIgnorePaths": [
    "**/*.spec.luau",
    "**/*.fixture.luau",
    "**/fixtures/**",
    "**/*.md",
    "**/.gitkeep",
    "**/*.yml"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Remotes": {
        "$className": "Folder",
        "Plant": { "$className": "RemoteFunction" },
        "Harvest": { "$className": "RemoteFunction" },
        "Sell": { "$className": "RemoteFunction" },
        "BuySeed": { "$className": "RemoteFunction" },
        "StateChanged": { "$className": "RemoteEvent" }
      },
      "Forge": {
        "$className": "Folder",
        "core": {
          "$className": "Folder",
          "domain": { "$path": "../../core/domain" },
          "infra": { "$path": "../../core/infra" },
          "anticheat": { "$path": "../../core/anticheat" },
          "ui-kit": { "$path": "../../core/ui-kit" }
        },
        "genres": {
          "$className": "Folder",
          "grow-harvest": {
            "$className": "Folder",
            "module": { "$path": "../../genres/grow-harvest/module" }
          },
          "survival-coop": {
            "$className": "Folder",
            "module": { "$path": "../../genres/survival-coop/module" }
          }
        },
        "games": {
          "$className": "Folder",
          "grow-and-defend-garden": {
            "$className": "Folder",
            "src": {
              "$className": "Folder",
              "shared": { "$path": "src/shared" }
            }
          }
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Size": [200, 1, 200],
          "Position": [0, -0.5, 0],
          "Anchored": true,
          "TopSurface": "Smooth",
          "Color": [96, 128, 84]
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Size": [12, 1, 12],
          "Position": [0, 0.5, 0],
          "Anchored": true,
          "Neutral": true
        }
      }
    },
    "ServerScriptService": {
      "PersistenceConfig": { "$path": "src/server/PersistenceConfig.luau" },
      "GardenServer": { "$path": "src/server/GardenServer.server.luau" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "GardenClient": { "$path": "src/client/GardenClient.client.luau" }
      }
    }
  }
}
