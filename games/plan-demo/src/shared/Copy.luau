--!strict
-- Copy: Sky Whale Egg Keepers's HUD user-facing text, injected into the
-- collect-raid genre Hud runtime so the genre never hardcodes display text.
-- Generated by forge plan.

local Hud = require("../../../../genres/collect-raid/module/runtime/Hud")

local Copy: Hud.Copy = {
	guiName = "PlanDemoGui",
	title = "Sky Whale Egg Keepers",
	buyEggsTitle = "Buy Eggs",
	mergeTitle = "Merge",
	raidQuestsTitle = "Raid & Quests",
	storeTitle = "Store",
	incubatorsHeader = "Incubators",
	hatchOddsHeader = "Hatch Odds",
	coinsLabel = function(coins: string): string
		return "Coins: " .. coins
	end,
	creaturesOwnedLabel = function(count: number): string
		return string.format("Kaiju Owned: %d", count)
	end,
	vaultedLabel = function(count: number): string
		return string.format("Vaulted: %d", count)
	end,
	emptyInventoryHint = "Hatch an egg to get your first kaiju",
	nextSiegeLabel = function(clock: string): string
		return "Next siege in " .. clock
	end,
	siegeActiveLabel = function(clock: string): string
		return "Siege ACTIVE " .. clock
	end,
	vaultCountsLabel = function(teamNames: { string }, counts: { [string]: number }): string
		local parts: { string } = {}
		for _, teamName in teamNames do
			table.insert(parts, string.format("%s vault: %d", teamName, counts[teamName] or 0))
		end
		return table.concat(parts, " | ")
	end,
	raidButtonText = "Raid rival vault",
	raidResultText = function(reason: string): string
		return "Raid: " .. reason
	end,
	raidNothingReason = "nothing to grab",
	mergeButtonText = function(displayName: string): string
		return string.format("Merge %s family", displayName)
	end,
	buyButtonText = function(id: string, price: number): string
		return string.format("Buy %s (%d Coins)", id, price)
	end,
	storeButtonText = function(name: string, price: number): string
		return string.format("%s - %d R$", name, price)
	end,
	storeUnpublishedText = "Not available until published",
	inviteButtonText = "Invite Friends",
	invitesUnavailableText = "Invites are not available here",
	dailyQuestsHeader = "Daily Quests",
	gamePassesHeader = "Game Passes",
	devProductsHeader = "Developer Products",
	claimButtonText = "Claim",
	claimedButtonText = "Claimed",
	questRowText = function(id: string, progress: number, target: number, reward: number): string
		return string.format("%s %d/%d (+%d)", id, progress, target, reward)
	end,
	hatchButtonText = function(index: number): string
		return string.format("Hatch #%d", index)
	end,
	hatchedPopText = function(creatureId: string): string
		return "Hatched " .. creatureId .. "!"
	end,
	slotStatusText = function(index: number, sourceId: string, remaining: string): string
		return string.format("Slot %d: %s (%s)", index, if sourceId ~= "" then sourceId else "Egg", remaining)
	end,
	tutorialPrefix = "Tutorial: ",
	isRareHatchNotify = function(text: string): boolean
		return string.find(text, "hatched", 1, true) ~= nil and string.find(text, "Legendary", 1, true) == nil
	end,
}

return Copy
