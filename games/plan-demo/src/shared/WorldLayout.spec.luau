--!strict
-- Specs for WorldLayout. Pure Luau, no Roblox APIs. Generated by forge plan.

local WorldLayout = require("./WorldLayout")

local tests = {}

local ORIGIN = { x = 0, y = 0, z = 0 }

local function dist(a: WorldLayout.Vec, b: WorldLayout.Vec)
	local dx = a.x - b.x
	local dy = a.y - b.y
	local dz = a.z - b.z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function findBase(team: string): WorldLayout.BaseLayout
	for _, base in WorldLayout.layout.bases do
		if base.team == team then
			return base
		end
	end
	error("unknown team: " .. team)
end

-- Luau cannot unify `{Decoration} | {}` as a single for..in iteration form, so
-- an explicitly typed empty fallback (not a bare `{}` literal) is required.
local EMPTY_DECOR: { WorldLayout.Decoration } = {}

local TEAMS = {
	"Red",
	"Blue",
}

local INCUBATORS_PER_TEAM = 6

function tests.every_team_has_a_base()
	assert(#WorldLayout.layout.bases == #TEAMS, "one base per team")
	for _, team in TEAMS do
		findBase(team)
	end
end

function tests.bases_are_equidistant_from_the_arena()
	local radius: number? = nil
	for _, team in TEAMS do
		local base = findBase(team)
		local d = dist(base.center, ORIGIN)
		if radius == nil then
			radius = d
		else
			assert(math.abs(d - radius) < 1e-3, team .. " base must sit on the same ring as the others")
		end
	end
end

function tests.incubators_are_spaced()
	for _, team in TEAMS do
		local base = findBase(team)
		assert(#base.incubators == INCUBATORS_PER_TEAM, team .. " must have INCUBATORS_PER_TEAM incubators")
		for i = 1, #base.incubators do
			for j = i + 1, #base.incubators do
				local d = dist(base.incubators[i], base.incubators[j])
				assert(
					d >= 10,
					team .. " incubators " .. tostring(i) .. " and " .. tostring(j) .. " too close: " .. tostring(d)
				)
			end
		end
	end
end

function tests.vault_is_closer_than_spawn()
	for _, team in TEAMS do
		local base = findBase(team)
		assert(
			dist(base.vault, ORIGIN) < dist(base.spawn, ORIGIN),
			team .. " vault must be closer to the arena than its spawn"
		)
	end
end

function tests.arena_shape()
	local arena = WorldLayout.layout.arena
	assert(arena.radius == 40, "arena radius must be 40")
	assert(#arena.covers == 4, "arena must have 4 covers")
end

function tests.bases_clear_of_arena()
	local arena = WorldLayout.layout.arena
	for _, team in TEAMS do
		local base = findBase(team)
		local edge = dist(base.center, ORIGIN) - base.size.x / 2
		assert(edge > arena.radius, team .. " base overlaps the arena")
	end
end

function tests.unknown_team_errors()
	assert(pcall(findBase, "Nonexistent-Team") == false, "unknown team must error")
end

function tests.decorations_are_scattered_by_kind()
	local decorations = WorldLayout.layout.decorations or EMPTY_DECOR
	assert(#decorations >= 81 and #decorations <= 99, "about ninety decorations, got " .. #decorations)

	local counts: { [string]: number } = {}
	for _, d in decorations do
		counts[d.kind] = (counts[d.kind] or 0) + 1
	end
	assert((counts.Tree or 0) >= 36, "trees are the bulk of the scatter")
	assert((counts.Rock or 0) >= 24, "rocks are a large share")
	assert((counts.Crystal or 0) >= 11, "crystals accent the arena and bases")
	assert((counts.Crate or 0) >= 7, "crates cluster near the bases")
	assert(counts.Tree + counts.Rock + counts.Crystal + counts.Crate == #decorations, "only known kinds")
end

function tests.decorations_stay_on_grass()
	local arena = WorldLayout.layout.arena
	for _, d in WorldLayout.layout.decorations or EMPTY_DECOR do
		assert(math.abs(d.position.x) <= 190 and math.abs(d.position.z) <= 190, "decor stays on the ground grid")
		local dx, dz = d.position.x - arena.center.x, d.position.z - arena.center.z
		assert(math.sqrt(dx * dx + dz * dz) > arena.radius, "decor stays off the arena floor")
		assert(d.position.y >= 0, "decor sits on the ground")
	end
	for _, team in TEAMS do
		local base = findBase(team)
		local half = base.size.x / 2
		for _, d in WorldLayout.layout.decorations or EMPTY_DECOR do
			local inside = math.abs(d.position.x - base.center.x) < half
				and math.abs(d.position.z - base.center.z) < half
			assert(not inside, "decor stays off the " .. team .. " base")
		end
	end
end

function tests.flowers_are_patched_and_clear()
	local flowers = WorldLayout.layout.flowers or EMPTY_DECOR
	assert(#flowers >= 36 and #flowers <= 44, "about forty flower patches")
	local arena = WorldLayout.layout.arena
	for _, f in flowers do
		assert(f.kind == "Flower", "flower patches are tagged")
		local dx, dz = f.position.x - arena.center.x, f.position.z - arena.center.z
		assert(math.sqrt(dx * dx + dz * dz) > arena.radius, "flowers stay off the arena")
	end
end

return tests
