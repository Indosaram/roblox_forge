local notifyClassifiers: Audio.NotifyClassifiers = {
	isRareHatch = function(text: string): boolean
		return string.find(text, "hatched", 1, true) ~= nil
	end,
	isHatchFailure = function(text: string): boolean
		return string.find(text, "Hatch:", 1, true) == 1
	end,
	isRaidText = function(text: string): boolean
		return string.find(text, "Raid", 1, true) ~= nil
	end,
}

local promptClassifiers: Audio.PromptClassifiers = {
	isHatchAction = function(actionText: string): boolean
		return string.find(string.lower(actionText), "hatch", 1, true) ~= nil
	end,
	isRaidAction = function(actionText: string): boolean
		return string.find(string.lower(actionText), "raid", 1, true) ~= nil
