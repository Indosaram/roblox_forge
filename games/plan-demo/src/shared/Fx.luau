--!strict
-- Fx: particle/sound/UI feedback helpers. Generated by forge plan; only the
-- rarity color table below is roster-derived, the rest is genre-generic.
local Fx = {}
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")
local Assets = require("./Assets")

Fx.SOUNDS = {
	click = Assets.sfxClick,
	hatch = Assets.sfxHatch,
	rare = Assets.sfxRare,
	coin = Assets.sfxCoin,
	raid = Assets.sfxRaid,
	error = Assets.sfxError,
}

function Fx.play(name: string, volume: number?): ()
	local soundId = Fx.SOUNDS[name]
	if soundId == nil or soundId == "" then
		return
	end

	local sound = Instance.new("Sound")
	sound.SoundId = soundId
	sound.Volume = volume or 0.5
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 6)
end

function Fx.burst(position: Vector3, color: Color3, count: number?): ()
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 1)
	part.Position = position
	part.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.8
	emitter.Speed = NumberRange.new(8, 16)
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.2),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Rate = 0
	emitter.Parent = part

	emitter:Emit(count or 40)
	Debris:AddItem(part, 3)
end

function Fx.popText(parent: GuiBase2d, text: string, color: Color3): ()
	local label = Instance.new("TextLabel")
	label.Text = text
	label.Font = Enum.Font.GothamBold
	label.TextSize = 28
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.4
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromOffset(300, 40)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromScale(0.5, 0.45)
	label.Parent = parent

	local tween =
		TweenService:Create(label, TweenInfo.new(1.2), { Position = UDim2.fromScale(0.5, 0.35), TextTransparency = 1 })
	tween:Play()
	Debris:AddItem(label, 1.5)
end

function Fx.flash(screenGui: ScreenGui, color: Color3): ()
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 0.4
	frame.ZIndex = 50
	frame.Size = UDim2.fromScale(1, 1)
	frame.Parent = screenGui

	local tween = TweenService:Create(frame, TweenInfo.new(0.5), { BackgroundTransparency = 1 })
	tween:Play()
	Debris:AddItem(frame, 0.6)
end

function Fx.rarityColor(rarity: string): Color3
	if rarity == "Common" then
		return Color3.fromRGB(200, 200, 200)
	end
	if rarity == "Rare" then
		return Color3.fromRGB(80, 160, 255)
	end
	if rarity == "Legendary" then
		return Color3.fromRGB(255, 190, 40)
	end
	return Color3.new(1, 1, 1)
end

return Fx
