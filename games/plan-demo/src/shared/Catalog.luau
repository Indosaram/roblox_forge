--!strict
-- Catalog: generated by forge plan from game.yml monetization. Deterministic only:
-- Robux never buys a random item (see AGENTS.md). Each entry's `id` stays 0 until the
-- item is created on Roblox and is filled in at publish time.

export type GrantKind = "multiplier" | "slots" | "flag" | "kaiju" | "speedup" | "shield" | "serverBoost"

export type Grant = {
	kind: GrantKind,
	value: number?,
	flag: string?,
	kaijuId: string?,
	seconds: number?,
}

export type Entry = {
	id: number,
	key: string,
	name: string,
	price: number,
	grant: Grant,
}

export type Catalog = {
	gamepasses: { Entry },
	products: { Entry },
}

local Catalog = {}

Catalog.gamepasses = {
	{ id = 0, key = "coins2x", name = "2x Coins", price = 699, grant = { kind = "multiplier", value = 2 } },
	{ id = 0, key = "vipSlots", name = "VIP Slots +4", price = 699, grant = { kind = "slots", value = 4 } },
	{ id = 0, key = "autoLock", name = "Auto Lock", price = 199, grant = { kind = "flag", flag = "autoLock" } },
} :: { Entry }

Catalog.products = {
	{
		id = 0,
		key = "creaturePack",
		name = "Guaranteed Rare Creature Pack",
		price = 99,
		grant = { kind = "kaiju", kaijuId = "island-serpent" },
	},
	{
		id = 0,
		key = "hatchSpeedup",
		name = "Hatch Speed-Up",
		price = 699,
		grant = { kind = "speedup", seconds = 3600 },
	},
	{ id = 0, key = "siegeShield", name = "Siege Shield", price = 99, grant = { kind = "shield", seconds = 600 } },
	{
		id = 0,
		key = "luckBoost",
		name = "Server Luck Boost 15m",
		price = 199,
		grant = { kind = "serverBoost", seconds = 900 },
	},
} :: { Entry }

-- Lookups by Roblox id only include published items (id > 0); key lookups cover all.
Catalog.gamepassById = {} :: { [number]: Entry }
Catalog.productById = {} :: { [number]: Entry }
Catalog.gamepassByKey = {} :: { [string]: Entry }
Catalog.productByKey = {} :: { [string]: Entry }

for _, entry in Catalog.gamepasses do
	Catalog.gamepassByKey[entry.key] = entry
	if entry.id > 0 then
		Catalog.gamepassById[entry.id] = entry
	end
end
for _, entry in Catalog.products do
	Catalog.productByKey[entry.key] = entry
	if entry.id > 0 then
		Catalog.productById[entry.id] = entry
	end
end

return Catalog
