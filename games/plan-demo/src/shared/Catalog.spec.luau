--!strict
-- Specs for the game catalog: core validation passes and no paid random items.
-- Generated by forge plan.

local CatalogCore = require("../../../../core/infra/monetization/Catalog")
local Catalog = require("./Catalog")

return {
	["pack catalog passes core Catalog.validate"] = function()
		local ok, reason = CatalogCore.validate(Catalog)
		assert(ok == true, "catalog must validate: " .. tostring(reason))
		assert(reason == nil, "no reason on success")
	end,

	["no catalog entry grants a random item"] = function()
		local sections: { { Catalog.Entry } } = { Catalog.gamepasses, Catalog.products }
		for _, section in sections do
			for _, entry in section do
				local grant: any = entry.grant
				local kind = entry.grant.kind
				assert(kind ~= "random" and kind ~= "roll" and kind ~= "egg", "random grant: " .. entry.key)
				assert(grant.pool == nil and grant.odds == nil, "pool/odds grant: " .. entry.key)
			end
		end
	end,

	["kaiju products name a fixed kaiju id"] = function()
		local EconConfig = require("./EconConfig")
		for _, entry in Catalog.products do
			if entry.grant.kind == "kaiju" then
				local kaijuId = entry.grant.kaijuId
				assert(type(kaijuId) == "string" and kaijuId ~= "", "fixed kaijuId required: " .. entry.key)
				-- A typo here passes the string check but makes the grant a no-op, so the
				-- receipt loop would retry forever without delivering anything.
				assert(
					EconConfig.kaiju[kaijuId] ~= nil,
					"kaijuId " .. tostring(kaijuId) .. " is not an EconConfig.kaiju entry: " .. entry.key
				)
			end
		end
	end,
}
