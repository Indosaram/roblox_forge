--!strict
-- CreatureModels: thin ProcAssets-backed model builders. Generated by forge plan.
-- Every roster creature/egg has a procedural spec (assets/procgen.yml), so
-- buildKaiju/buildEgg always resolve through ProcAssets; the rarity table
-- below is the only hand data (used for showcase scale and Fx aura color).

local ProcAssets = require("../../../../core/infra/render/ProcAssets")
local ProcAssetsSpecs = require("./ProcAssets")

local RARITY: { [string]: string } = {
	["island-scamper"] = "Common",
	["island-serpent"] = "Rare",
	["island-colossus"] = "Legendary",
	["sky-pup"] = "Common",
	["sky-stalker"] = "Rare",
	["sky-leviathan"] = "Legendary",
}

local SCALE: { [string]: number } = {
	["island-scamper"] = 1,
	["island-serpent"] = 1.4,
	["island-colossus"] = 2,
	["sky-pup"] = 1,
	["sky-stalker"] = 1.4,
	["sky-leviathan"] = 2,
}

local CreatureModels = {}

--- Builds a creature's showcase model, scaled so its largest extent reads at
--- 7 studs for a Common (bigger rarities scale up per SCALE).
function CreatureModels.buildKaiju(kaijuId: string): Model
	local model = ProcAssets.build(ProcAssetsSpecs, kaijuId, kaijuId)
	if model == nil then
		error("CreatureModels.buildKaiju: no procgen spec for '" .. kaijuId .. "'")
	end
	model:SetAttribute("KaijuId", kaijuId)
	local scale = SCALE[kaijuId] or 1
	local extents = model:GetExtentsSize()
	local largest = math.max(extents.X, extents.Y, extents.Z)
	if largest > 1e-4 then
		model:ScaleTo(7 * scale / largest)
	end
	return model
end

--- Builds an egg's showcase model (forceParts: eggs never use EditableMesh),
--- scaled to read 3 studs tall at the incubator point.
function CreatureModels.buildEgg(eggId: string): Model
	local model = ProcAssets.build(ProcAssetsSpecs, eggId, eggId, { forceParts = true })
	if model == nil then
		error("CreatureModels.buildEgg: no procgen spec for '" .. eggId .. "'")
	end
	model:SetAttribute("EggId", eggId)
	local extents = model:GetExtentsSize()
	local largest = math.max(extents.X, extents.Y, extents.Z)
	if largest > 1e-4 then
		model:ScaleTo(3 / largest)
	end
	return model
end

function CreatureModels.rarityOf(kaijuId: string): string
	return RARITY[kaijuId] or "Common"
end

return CreatureModels
