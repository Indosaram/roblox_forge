--!strict
-- Pure, engine-free smoke checks. Requires only the pack's pure modules
-- (src/shared) and core/domain; the default path touches no Roblox APIs and
-- no Lune APIs, so the same source can be bundled as text for an Open Cloud
-- Luau Execution task. Generated by forge plan.

local Loop = require("../../../genres/collect-raid/module/runtime/Loop")
local Config = require("../src/shared/Config")
local ProfileSchema = require("../../../core/domain/state/ProfileSchema")

export type Check = {
	name: string,
	ok: boolean,
	detail: string,
}

local M = {}

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function pass(name: string, detail: string): Check
	return { name = name, ok = true, detail = detail }
end

local function fail(name: string, detail: string): Check
	return { name = name, ok = false, detail = detail }
end

-- Resolves the optional fixture argument: nil (fresh player), an already-decoded
-- save table (the CLI and spec decode the JSON), or a JSON path read lazily
-- through @lune. The @lune require is only reached for an explicit local path,
-- never on the default or cloud path.
local function resolveFixture(fixture: any): (any, string?)
	if fixture == nil then
		return nil, nil
	end
	if type(fixture) == "table" then
		return fixture, nil
	end
	if type(fixture) == "string" then
		local dynamicRequire = require :: any
		local readOk, decoded = pcall(function()
			local fs = dynamicRequire("@lune/fs")
			local serde = dynamicRequire("@lune/serde")
			return serde.decode("json", fs.readFile(fixture))
		end)
		if not readOk then
			return nil, "failed to read fixture: " .. tostring(decoded)
		end
		if type(decoded) ~= "table" then
			return nil, "fixture did not decode to a table"
		end
		return decoded, nil
	end
	return nil, "unsupported fixture type: " .. typeof(fixture)
end

-- (a) Save round-trip: snapshot, serialize, restore, and compare coins plus the
-- incubator count. With a fixture the decoded save is validated (and must be
-- corrupt for the shipped fixture, whose coins field is not a number).
local function checkProfileRoundTrip(fixture: any): Check
	local name = "profile round-trip"
	local now = 0
	local state
	if fixture ~= nil then
		if not isFiniteNumber(fixture.coins) then
			return fail(name, "fixture coins is not a finite number: " .. tostring(fixture.coins))
		end
		state = Loop.fromSave(Config, fixture, now)
	else
		state = Loop.newPlayer(Config, now)
		local bought, err = Loop.buySource(Config, state, "island", now)
		if not bought then
			return fail(name, "buySource(island) failed: " .. tostring(err))
		end
	end

	local before = Loop.snapshot(Config, state, 10)
	if not isFiniteNumber(before.coins) or before.coins < 0 then
		return fail(name, "pre-save coins is not a finite number >= 0: " .. tostring(before.coins))
	end

	local save = Loop.toSave(Config, state, 10)
	local restored = Loop.fromSave(Config, save, 10)
	local after = Loop.snapshot(Config, restored, 10)
	if not isFiniteNumber(after.coins) or after.coins < 0 then
		return fail(name, "restored coins is not a finite number >= 0: " .. tostring(after.coins))
	end
	if after.coins ~= before.coins then
		return fail(name, string.format("coins changed across save/load: %d -> %d", before.coins, after.coins))
	end
	if #after.incubators ~= #before.incubators then
		return fail(
			name,
			string.format("incubators changed across save/load: %d -> %d", #before.incubators, #after.incubators)
		)
	end
	return pass(name, string.format("coins %d, incubators %d", after.coins, #after.incubators))
end

-- (b) Econ config validity: positive prices, non-empty pools, known creatures, and
-- merge rules that resolve to existing creatures.
local function checkEconConfig(): Check
	local name = "econ config"
	local eggCount = 0
	for eggId, egg in Config.sources do
		eggCount += 1
		if not (type(egg.price) == "number" and egg.price > 0) then
			return fail(name, "egg '" .. eggId .. "' has non-positive price: " .. tostring(egg.price))
		end
		local weightSum = 0
		for _, entry in egg.pool do
			if Config.creatures[entry.id] == nil then
				return fail(name, "egg '" .. eggId .. "' pools unknown creature: " .. tostring(entry.id))
			end
			if not (type(entry.weight) == "number" and entry.weight >= 0) then
				return fail(name, "egg '" .. eggId .. "' has invalid weight for " .. tostring(entry.id))
			end
			weightSum += entry.weight
		end
		if not (weightSum > 0) then
			return fail(name, "egg '" .. eggId .. "' pool weights sum to " .. tostring(weightSum))
		end
	end
	for _, family in Config.mergeFamilies do
		for _, rule in family.rules do
			if Config.creatures[rule.resultId] == nil then
				return fail(
					name,
					"merge rule in '" .. family.id .. "' references unknown creature: " .. tostring(rule.resultId)
				)
			end
		end
	end
	return pass(name, string.format("%d eggs and %d merge families valid", eggCount, #Config.mergeFamilies))
end

-- (c) Serialization walk: the save holds only strings/numbers/booleans/tables,
-- with no NaN/inf, no functions, and no cycles.
local function checkSerialization(): Check
	local name = "save serialization"
	local state = Loop.newPlayer(Config, 0)
	Loop.buySource(Config, state, "island", 0)
	local save = Loop.toSave(Config, state, 10)

	local seen = {}
	local stack: { any } = { save }
	while #stack > 0 do
		local value = table.remove(stack)
		local valueType = typeof(value)
		if valueType == "number" then
			if not isFiniteNumber(value) then
				return fail(name, "non-finite number in save: " .. tostring(value))
			end
		elseif valueType == "table" then
			if seen[value] then
				return fail(name, "cycle detected in save table")
			end
			seen[value] = true
			for key, child in value do
				local keyType = typeof(key)
				if keyType ~= "string" and keyType ~= "number" then
					return fail(name, "table key is not a string/number: " .. tostring(key))
				end
				table.insert(stack, child)
			end
		elseif valueType ~= "string" and valueType ~= "boolean" then
			return fail(name, "unsupported value type in save: " .. valueType)
		end
	end
	return pass(name, "save is plain DataStore-safe data")
end

-- (d) Profile migration: migrating an empty record with the pack defaults fills
-- every default key.
local function checkProfileMigrate(): Check
	local name = "profile migration"
	local migrated = ProfileSchema.migrate({}, Config.profile.version, Config.profile.defaults, {})
	for key in Config.profile.defaults() do
		if migrated[key] == nil then
			return fail(name, "missing default key: " .. tostring(key))
		end
	end
	return pass(name, "migration fills every default key")
end

--- Runs every smoke check. `fixture` may be nil, a decoded save table, or a
--- JSON path string (read lazily through @lune).
function M.run(fixture: any?): { Check }
	local fixtureTable, fixtureErr = resolveFixture(fixture)
	if fixtureErr ~= nil then
		return {
			fail("fixture load", fixtureErr),
			checkEconConfig(),
			checkSerialization(),
			checkProfileMigrate(),
		}
	end
	return {
		checkProfileRoundTrip(fixtureTable),
		checkEconConfig(),
		checkSerialization(),
		checkProfileMigrate(),
	}
end

return M
