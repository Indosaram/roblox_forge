--!strict
-- Specs for the smoke checks: the default run passes every check, and the
-- corrupt fixture fails at least one. Generated by forge plan.

local fs = require("@lune/fs")
local serde = require("@lune/serde")

local Smoke = require("./smoke")

-- Specs run from the repository root.
local FIXTURE_PATH = "games/plan-demo/smoke/fixtures/corrupt-save.json"

local function anyFailed(checks: { any }): boolean
	for _, check in checks do
		if not check.ok then
			return true
		end
	end
	return false
end

return {
	["the default smoke passes every check"] = function()
		local checks = Smoke.run()
		assert(#checks > 0, "expected at least one smoke check")
		for _, check in checks do
			assert(check.ok, check.name .. " failed: " .. check.detail)
		end
	end,

	["the corrupt fixture fails at least one check"] = function()
		local decoded = serde.decode("json", fs.readFile(FIXTURE_PATH))
		local checks = Smoke.run(decoded)
		assert(#checks > 0, "expected at least one smoke check")
		assert(anyFailed(checks), "the corrupt save fixture should fail at least one check")
	end,
}
