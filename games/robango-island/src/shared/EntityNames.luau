return function(locale: string): { [string]: string }
	local korean = string.sub(string.lower(locale), 1, 2) == "ko"
	local out: { [string]: string } = {}
	for id, entry in names do
		out[id] = if korean then entry.ko else entry.en
	end
	return out
end
