        "Brightness": 2.4,
        "ClockTime": 14.5,
        "EnvironmentDiffuseScale": 0.35,
        "EnvironmentSpecularScale": 0.35,
        "ExposureCompensation": 0.2,
        "GeographicLatitude": 41.7,
        "GlobalShadows": true,
        "OutdoorAmbient": [
          0.5019607843137255,
          0.5333333333333333,
          0.5803921568627451
        ],
        "Technology": "ShadowMap"
      },
      "ForgeAtmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Color": [
            0.7803921568627451,
