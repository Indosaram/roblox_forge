{
  "globIgnorePaths": [
    "**/*.spec.luau",
    "**/*.fixture.luau",
    "**/fixtures/**",
    "../../core/domain/procgen/Icons.luau",
    "../../core/domain/procgen/Music.luau",
    "../../core/domain/procgen/Synth.luau",
    "**/*.md",
    "**/.gitkeep",
    "**/*.yml"
  ],
  "name": "robango-island",
  "tree": {
    "$className": "DataModel",
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Ambient": [
